+static void
+sweet_smem_check_crash(struct smem_partition_header *phdr, uint32_t part_size)
+{
+	uint32_t csz = 0;
+	char *cmsg = (char *)sweet_smem_get_entry(phdr, part_size, 421, &csz);
+	if (cmsg && cmsg[0]) {
+		static char last_crash[128];
+		if (strncmp(last_crash, cmsg, sizeof(last_crash)) != 0) {
+			strncpy(last_crash, cmsg, sizeof(last_crash) - 1);
+			printf("SWEET MPSS CRASH: %s\n", cmsg);
+			note("[CRASH: %.50s]", cmsg);
+		}
+	}
