 static void
 mpss_thread(void *arg, wait_result_t result)
 {
 #pragma unused(arg, result)
 	bool ok = mpss_start();
 
-	for (int s = 1; s <= 30; s++) {
+	for (int s = 1; s <= 600; s++) {
 		sleep_ms(1000);
-		printf("SWEET MPSS: alive %d s after %s: %s\n", s, ok ? "the start" : "the failure", report);
+		if (ok) {
+			sweet_smem_poll(s);
+		}
+		if (s <= 30 || s % 10 == 0) {
+			printf("SWEET MPSS: alive %d s after %s: %s\n", s, ok ? "the start" : "the failure", report);
+		}
 	}
 	(void)thread_terminate(current_thread());
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
