+/* Two pixels averaged, each channel (rounded up). */
+static inline uint32_t
+sweet_fb_mix(uint32_t a, uint32_t b)
+{
+	return ((a >> 1) & 0x7f7f7f7fu) + ((b >> 1) & 0x7f7f7f7fu) + ((a | b) & 0x01010101u);
+}
+
+/*
+ * kern.sweetfb_fit: a layer's w x h pixels from (sx, sy) of src, placed at (dx, dy) of the presented
+ * display, shrunk onto the panel through fFitCol and fFitRow.
+ */
+void
+AppleCLCD::fitLayer(uintptr_t src, uint32_t row, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	for (uint32_t r = 0; r < fFitH; r++) {
+		int32_t ly = (int32_t)(fFitRow[r] & ~SWEET_FB_FIT_MIX) - dy;
+		if (ly < 0 || ly >= h) {
+			continue;
+		}
+		bool ymix = (fFitRow[r] & SWEET_FB_FIT_MIX) && ly + 1 < h;
+		const uint32_t *r0 = (const uint32_t *)(src + (uint64_t)(sy + ly) * row) + sx;
+		const uint32_t *r1 = (const uint32_t *)((uintptr_t)r0 + (ymix ? row : 0));
+		uint32_t *out = (uint32_t *)(fPixels + (uint64_t)(fFitTop + r) * fRowBytes);
+		for (uint32_t c = 0; c < fWidth; c++) {
+			int32_t lx = (int32_t)(fFitCol[c] & ~SWEET_FB_FIT_MIX) - dx;
+			if (lx < 0 || lx >= w) {
+				continue;
+			}
+			uint32_t v = r0[lx];
+			bool xmix = (fFitCol[c] & SWEET_FB_FIT_MIX) && lx + 1 < w;
+			if (xmix) {
+				v = sweet_fb_mix(v, r0[lx + 1]);
+			}
+			if (ymix) {
+				uint32_t u = r1[lx];
+				if (xmix) {
+					u = sweet_fb_mix(u, r1[lx + 1]);
+				}
+				v = sweet_fb_mix(v, u);
+			}
+			out[c] = v;
+		}
+	}
+}
