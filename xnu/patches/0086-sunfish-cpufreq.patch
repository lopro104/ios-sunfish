diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
new file mode 100644
index 0000000..6452479
--- /dev/null
+++ b/bsd/dev/sweet_cpufreq.c
@@ -0,0 +1,192 @@
+/*
+ * The clock speed of the SM7150's processor cores (sunfish). Nothing here runs without boot-arg cpufreq.
+ *
+ * The boot loader leaves each group of cores at a modest frequency and expects the operating system
+ * to ask for more. On this SoC that is one register write: the hardware ("OSM", Linux's
+ * qcom-cpufreq-hw, the sdm845-style register set) has a table of frequencies per group, built by the
+ * firmware, and switches the clock and the voltage by itself when told which row is wanted.
+ *
+ * Ported from HackiOS (OOSEX GANG, hackios-xnu-kernel branch "metal", xnu/files/bsd/dev/hk_cpufreq.c,
+ * APSL 2.0): the idea (every group with a core of ours goes to its top row; the thermal service caps
+ * it), the interface the thermal service uses, and the loop that shows the difference. Their SoC has
+ * the newer "EPSS" block; the registers here are OSM's.
+ *
+ *   cpufreq=2   read only: each group's table and the row it runs at go to the log
+ *   cpufreq=1   that, and every group with one of our cores in it (cpus=N) to its top row; the
+ *               thermal service (sweet_thermal.c) then slows it down when it gets hot
+ *
+ * Registers (linux drivers/cpufreq/qcom-cpufreq-hw.c, qcom_soc_data; sm7150.dtsi cpufreq@18323000):
+ *   group 0 (the six Cortex-A55, cpu0-5) at 0x18323000, group 1 (the two Cortex-A76) at 0x18325800
+ *   0x000 enable           bit 0: the firmware runs this group
+ *   0x110 + 32 n           table row n: [31:30] clock source (0: GPLL0 / 2 = 300 MHz, else the PLL),
+ *                          [18:16] core count (1: a boost row), [7:0] multiple of 19.2 MHz
+ *   0x114 + 32 n           the row's voltage, [11:0] in mV
+ *   0x704                  the row in force now ([9:0] multiple of 19.2 MHz)
+ *   0x920                  the row that is wanted
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+void sweet_cpufreq_init(void);
+int sweet_cpufreq_top(uint32_t domain);
+uint32_t sweet_cpufreq_khz(uint32_t domain, int row);
+void sweet_cpufreq_cap(uint32_t domain, int row);
+
+#define OSM_DOMAINS             2
+#define OSM_DOMAIN_SIZE         0x1400UL
+#define OSM_ENABLE              0x000
+#define OSM_FREQ_LUT            0x110
+#define OSM_VOLT_LUT            0x114
+#define OSM_LUT_ROW             32
+#define OSM_LUT_ROWS            40
+#define OSM_CURRENT_VOTE        0x704
+#define OSM_PERF_STATE          0x920
+#define LUT_TURBO_IND           1
+#define XO_KHZ                  19200
+#define ALTERNATE_KHZ           300000          /* GPLL0 (600 MHz) / 2 */
+
+static const uint64_t osm_phys[OSM_DOMAINS] = { 0x18323000ULL, 0x18325800ULL };
+static const char *const osm_name[OSM_DOMAINS] = { "A55 group (cpu0-5)", "A76 group (cpu6-7)" };
+
+/* each group's registers and table, once read; the top row once raised (for the thermal service's caps) */
+static vm_offset_t osm_base[OSM_DOMAINS];
+static int osm_top[OSM_DOMAINS] = { -1, -1 };
+static uint32_t osm_khz[OSM_DOMAINS][OSM_LUT_ROWS];
+
+static uint32_t
+rd(uint32_t domain, uint32_t offset)
+{
+	return *(volatile uint32_t *)(osm_base[domain] + offset);
+}
+
+/* How fast a simple loop runs, in thousands of iterations per millisecond (HackiOS's measure). */
+static uint32_t
+loop_speed(void)
+{
+	volatile uint64_t sink = 0;
+	uint64_t start = mach_absolute_time(), nanos;
+
+	for (uint32_t i = 0; i < 2000000; i++) {
+		sink += i;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &nanos);
+	return nanos ? (uint32_t)(2000000ULL * 1000 / nanos) : 0;
+}
+
+/*
+ * Read a group's table into osm_khz; returns its highest usable row (the last before the table
+ * repeats itself, boost rows left out as Linux leaves them out), -1 when the group is not running.
+ */
+static int
+read_table(uint32_t domain)
+{
+	uint32_t prev = 0;
+	int top = -1;
+
+	if (!(rd(domain, OSM_ENABLE) & 1u)) {
+		printf("SWEET CPUFREQ: %s: not enabled by the firmware (enable %#x); left alone\n", osm_name[domain],
+		    rd(domain, OSM_ENABLE));
+		return -1;
+	}
+	for (uint32_t row = 0; row < OSM_LUT_ROWS; row++) {
+		uint32_t entry = rd(domain, OSM_FREQ_LUT + OSM_LUT_ROW * row);
+		uint32_t mv = rd(domain, OSM_VOLT_LUT + OSM_LUT_ROW * row) & 0xfff;
+		uint32_t khz = (entry >> 30) ? XO_KHZ * (entry & 0xff) : ALTERNATE_KHZ;
+		uint32_t cores = (entry >> 16) & 7;
+
+		if (row > 0 && khz == prev) {
+			break;                  /* the table ends by repeating its last row */
+		}
+		osm_khz[domain][row] = khz;
+		printf("SWEET CPUFREQ: %s row %u: %u MHz, %u mV%s\n", osm_name[domain], row, khz / 1000, mv,
+		    cores == LUT_TURBO_IND ? " (boost: not used)" : "");
+		if (cores != LUT_TURBO_IND && (top < 0 || khz > osm_khz[domain][top])) {
+			top = (int)row;
+		}
+		prev = khz;
+	}
+	return top;
+}
+
+/*
+ * For the thermal service (sweet_thermal.c): the highest row of a group (-1 when it was not raised),
+ * how fast a row is, and a cap: the row the group is to run at, never above its top.
+ */
+int
+sweet_cpufreq_top(uint32_t domain)
+{
+	return domain < OSM_DOMAINS ? osm_top[domain] : -1;
+}
+
+uint32_t
+sweet_cpufreq_khz(uint32_t domain, int row)
+{
+	if (domain >= OSM_DOMAINS || row < 0 || row > osm_top[domain]) {
+		return 0;
+	}
+	return osm_khz[domain][row];
+}
+
+void
+sweet_cpufreq_cap(uint32_t domain, int row)
+{
+	if (domain >= OSM_DOMAINS || osm_top[domain] < 0) {
+		return;
+	}
+	if (row < 0) {
+		row = 0;
+	}
+	if (row > osm_top[domain]) {
+		row = osm_top[domain];
+	}
+	*(volatile uint32_t *)(osm_base[domain] + OSM_PERF_STATE) = (uint32_t)row;
+}
+
+void
+sweet_cpufreq_init(void)
+{
+	static bool started;
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t mode = 0, cores[OSM_DOMAINS] = { 0 }, before;
+
+	if (started || !PE_parse_boot_argn("cpufreq", &mode, sizeof(mode)) || mode == 0) {
+		return;
+	}
+	started = true;
+	/* our cores (cpus=N): MPIDR Aff1 is the core number, 0-5 the A55s, 6-7 the A76s */
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		cores[((topology->cpus[i].phys_id >> 8) & 0xff) < 6 ? 0 : 1]++;
+	}
+	before = loop_speed();
+	for (uint32_t d = 0; d < OSM_DOMAINS; d++) {
+		osm_base[d] = ml_io_map(osm_phys[d], OSM_DOMAIN_SIZE);
+		if (osm_base[d] == 0) {
+			printf("SWEET CPUFREQ: cannot map %s\n", osm_name[d]);
+			continue;
+		}
+		int top = read_table(d);
+		uint32_t was = rd(d, OSM_PERF_STATE), now_khz = XO_KHZ * (rd(d, OSM_CURRENT_VOTE) & 0x3ff);
+
+		printf("SWEET CPUFREQ: %s, %u of our cores: wanted row %u, running %u MHz, top row %d (%u MHz)\n", osm_name[d],
+		    cores[d], was, now_khz / 1000, top, top >= 0 ? osm_khz[d][top] / 1000 : 0);
+		if (mode != 1 || top < 0 || cores[d] == 0) {
+			continue;
+		}
+		*(volatile uint32_t *)(osm_base[d] + OSM_PERF_STATE) = (uint32_t)top;
+		delay_for_interval(20, NSEC_PER_MSEC);
+		osm_top[d] = top;
+		printf("SWEET CPUFREQ: %s raised: row %u -> %d, now running %u MHz\n", osm_name[d], was, top,
+		    XO_KHZ * (rd(d, OSM_CURRENT_VOTE) & 0x3ff) / 1000);
+	}
+	printf("SWEET CPUFREQ: a loop on this core ran at %u, now at %u (%s)\n", before, loop_speed(),
+	    mode == 1 ? "raised" : "cpufreq=2: read only");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
