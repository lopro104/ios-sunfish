From: sunfish-display
Subject: [PATCH] SweetFramebuffer: the copy into the panel shared by several processors (sweetfb_threads, default 3)

One processor took ~10.5 ms of every 16.7 to copy (shrink, with fit) a frame. Rows are
split between the vsync thread and helper threads (priority 81), as HackiOS fb_threads.
sweetfb_threads=1 is the old path.
---
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -49,6 +49,8 @@
 #include <IOKit/system.h>
 #include <pexpert/pexpert.h>
 #include <kern/clock.h>
+#include <mach/semaphore.h>
+#include <mach/sync_policy.h>
 
 /* osfmk/arm64/machine_routines.c; its header keeps it to Mach/pexpert code */
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
@@ -62,6 +64,33 @@
 extern "C" unsigned int sweet_fb_stat[4];       /* kern.sweetfb_shown, _retry, _older, _late */
 extern "C" unsigned int sweet_fb_present_us;
 extern "C" unsigned int sweet_fb_present_max_us;
+extern "C" kern_return_t kernel_thread_start_priority(thread_continue_t, void *, integer_t, thread_t *);
+
+/*
+ * The copy into the panel's memory, shared out: boot-arg sweetfb_threads=N (1 to
+ * SWEET_FB_MAX_THREADS, default 3) processors copy (or shrink, kern.sweetfb_fit) a layer's rows
+ * together, the vsync thread taking the first share and helper threads the others. One processor
+ * alone took ~10.5 ms of every 16.7 with fit on (kern.sweetfb_present_us). (HackiOS
+ * MiniIOMobileFramebuffer fb_threads: 9-10 ms became 3 with three.) sweetfb_threads=1 is the
+ * single-processor copy as it was.
+ */
+#define SWEET_FB_MAX_THREADS    4
+#define SWEET_FB_THREAD_PRI     81      /* above every user thread, under the Wi-Fi service (92) */
+
+class AppleCLCD;
+struct SweetFBJob {
+	AppleCLCD      *fb;
+	bool            fit;
+	/* fit: a layer shrunk onto the panel rows [from, to) of the fit area (fitLayer) */
+	uintptr_t       src;
+	uint32_t        row;
+	int32_t         sx, sy, dx, dy, w, h;
+	uint32_t       *line;
+	/* not fit: rows [from, to) of a straight copy */
+	uintptr_t       dst, srcRow;
+	uint32_t        dstStride, bytes;
+	uint32_t        from, to;
+};
 #include <sys/proc.h>
 
 enum {
@@ -171,7 +200,15 @@
 	bool          fFitShown;      /* the rows above and below the shrunk picture are black */
 	int           fFitWas;
 
-	void fitLayer(uintptr_t src, uint32_t row, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h);
+	void fitLayer(uintptr_t src, uint32_t row, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h,
+	    uint32_t from, uint32_t to, uint32_t *line);
+	void shareRows(const SweetFBJob &job, uint32_t rows);
+	static void helperMain(void *arg, wait_result_t result);
+	unsigned      fThreads;         /* processors that copy a frame (sweetfb_threads) */
+	semaphore_t   fGo[SWEET_FB_MAX_THREADS], fDone;
+	SweetFBJob    fJob[SWEET_FB_MAX_THREADS];
+	uint32_t     *fLines[SWEET_FB_MAX_THREADS];    /* each one's fFitLine */
+	void runJob(const SweetFBJob &job);
 
 	void cmdModeSetup(void);
 	void kick(void);
@@ -331,6 +368,28 @@
 		fFitRow = (uint16_t *)IOMallocData(fFitH * sizeof(uint16_t));
 		fFitLine = (uint32_t *)IOMallocData(fWidth * sizeof(uint32_t));
 	}
+	fThreads = 3;
+	PE_parse_boot_argn("sweetfb_threads", &fThreads, sizeof(fThreads));
+	if (fThreads < 1 || fThreads > SWEET_FB_MAX_THREADS) {
+		fThreads = 1;
+	}
+	fLines[0] = fFitLine;
+	if (fThreads > 1 && semaphore_create(kernel_task, &fDone, SYNC_POLICY_FIFO, 0) != KERN_SUCCESS) {
+		fThreads = 1;
+	}
+	for (unsigned i = 1; i < fThreads; i++) {
+		thread_t thread;
+		fJob[i].fb = this;              /* before the helper starts: it finds its index from it */
+		fLines[i] = (uint32_t *)IOMallocData(fWidth * sizeof(uint32_t));
+		if (fLines[i] == NULL || semaphore_create(kernel_task, &fGo[i], SYNC_POLICY_FIFO, 0) != KERN_SUCCESS ||
+		    kernel_thread_start_priority(&AppleCLCD::helperMain, &fJob[i], SWEET_FB_THREAD_PRI, &thread) != KERN_SUCCESS) {
+			IOLog("SWEET FB: copy helper %u not started; %u processors copy\n", i, i);
+			fThreads = i;
+			break;
+		}
+		thread_deallocate(thread);
+	}
+	IOLog("SWEET FB: %u processor%s copy each frame (boot-arg sweetfb_threads)\n", fThreads, fThreads == 1 ? "" : "s");
 	if (fFitCol != NULL && fFitRow != NULL && fFitLine != NULL) {
 		for (uint32_t i = 0; i < fWidth || i < fFitH; i++) {
 			uint32_t j = i % 24, at = i / 24 * 25 + (j <= 12 ? j : j + 1);
@@ -739,12 +798,13 @@
  * display, shrunk onto the panel through fFitCol and fFitRow.
  */
 void
-AppleCLCD::fitLayer(uintptr_t src, uint32_t row, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+AppleCLCD::fitLayer(uintptr_t src, uint32_t row, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h,
+    uint32_t from, uint32_t to, uint32_t *line)
 {
 	/* A layer as wide as the display (the screen's): each row straight from the surface. */
 	bool whole = dx == 0 && w >= (int32_t)fLogicalW && fWidth % 24 == 0;
 
-	for (uint32_t r = 0; r < fFitH; r++) {
+	for (uint32_t r = from; r < to && r < fFitH; r++) {
 		int32_t ly = (int32_t)(fFitRow[r] & ~SWEET_FB_FIT_MIX) - dy;
 		if (ly < 0 || ly >= h) {
 			continue;
@@ -787,17 +847,69 @@
 				}
 				v = sweet_fb_mix(v, u);
 			}
-			fFitLine[c] = v;
+			line[c] = v;
 			first = first < 0 ? (int32_t)c : first;
 			last = (int32_t)c;
 		}
 		if (first >= 0) {
-			memcpy(out + first, fFitLine + first, (size_t)(last - first + 1) * sizeof(uint32_t));
+			memcpy(out + first, line + first, (size_t)(last - first + 1) * sizeof(uint32_t));
 		}
 	}
 }
 
 void
+AppleCLCD::runJob(const SweetFBJob &job)
+{
+	if (job.fit) {
+		fitLayer(job.src, job.row, job.sx, job.sy, job.dx, job.dy, job.w, job.h, job.from, job.to, job.line);
+		return;
+	}
+	for (uint32_t y = job.from; y < job.to; y++) {
+		memcpy((void *)(job.dst + (uint64_t)y * job.dstStride), (const void *)(job.srcRow + (uint64_t)y * job.row),
+		    job.bytes);
+	}
+}
+
+/* A helper: its share of each frame when told, then "done". */
+void
+AppleCLCD::helperMain(void *arg, wait_result_t result __unused)
+{
+	SweetFBJob *mine = (SweetFBJob *)arg;
+	AppleCLCD *fb = mine->fb;
+	unsigned i = (unsigned)(mine - fb->fJob);
+
+	for (;;) {
+		semaphore_wait(fb->fGo[i]);
+		fb->runJob(fb->fJob[i]);
+		semaphore_signal(fb->fDone);
+	}
+}
+
+/* rows [0, rows) of job split between fThreads processors; back when all are done */
+void
+AppleCLCD::shareRows(const SweetFBJob &job, uint32_t rows)
+{
+	unsigned n = rows >= 64 ? fThreads : 1;
+
+	for (unsigned i = 1; i < n; i++) {
+		fJob[i] = job;
+		fJob[i].fb = this;
+		fJob[i].from = (uint32_t)((uint64_t)rows * i / n);
+		fJob[i].to = (uint32_t)((uint64_t)rows * (i + 1) / n);
+		fJob[i].line = fLines[i];
+		semaphore_signal(fGo[i]);
+	}
+	SweetFBJob first = job;
+	first.from = 0;
+	first.to = (uint32_t)(rows / n);
+	first.line = fLines[0];
+	runJob(first);
+	for (unsigned i = 1; i < n; i++) {
+		semaphore_wait(fDone);
+	}
+}
