+/*
+ * Surfaces the display still needs (queued, waiting for the GPU, or on the panel) are "in use":
+ * the u64 at +0x18 of the surface's shared state page is what IOSurfaceIsInUse reads (iOS 16.7
+ * IOSurface: client->state page ->[0x18] != 0). Core Animation does not draw into a surface in
+ * use; with Metal it otherwise drew the next frame into the one being copied to the panel (blocks
+ * of the screen gone in every animation). On with sweetmetal=1; boot-arg sweetfb_hold overrides.
+ */
+#define SWEET_SURFACE_STATE_USE         0x18
+#define SWEET_FB_HELD                   16
+static int sweet_fb_hold = -1;
 
 #if defined(SWEET)
 #include <IOKit/IOService.h>
