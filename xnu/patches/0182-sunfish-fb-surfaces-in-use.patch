+static void
+sweet_fb_use(SweetSurface *s, int64_t delta)
+{
+	if (s->state != NULL) {
+		OSAddAtomic64(delta, (volatile SInt64 *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USE));
+	}
+}
+
+/* Under fLock: raise the use count of the surfaces now needed, lower it of those no longer needed. */
+void
+AppleCLCD::updateHolds(void)
+{
+	uint32_t want[3 * SWEET_FB_LAYERS], wanted = 0;
+
+	if (sweet_fb_hold < 0) {
+		int on = 0, metal = 0;
+		if (!PE_parse_boot_argn("sweetfb_hold", &on, sizeof(on))) {
+			on = PE_parse_boot_argn("sweetmetal", &metal, sizeof(metal)) && metal != 0;
+		}
+		sweet_fb_hold = on != 0;
+		IOLog("SWEET FB: surfaces on the way to the panel %s in use\n", sweet_fb_hold ? "marked" : "not marked");
+	}
+	if (!sweet_fb_hold) {
+		return;
+	}
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		if (fDirty && (get32(fPending, 0x104) & (1u << layer)) && get32(fPending, 0x54 + 4 * layer) != 0) {
+			want[wanted++] = get32(fPending, 0x54 + 4 * layer);
+		}
+		if (fHaveReady && (get32(fReady, 0x104) & (1u << layer)) && get32(fReady, 0x54 + 4 * layer) != 0) {
+			want[wanted++] = get32(fReady, 0x54 + 4 * layer);
+		}
+		if (fShownIDs[layer] != 0) {
+			want[wanted++] = fShownIDs[layer];
+		}
+	}
+	for (uint32_t i = 0; i < fHeldCount;) {
+		bool keep = false;
+		for (uint32_t k = 0; k < wanted && !keep; k++) {
+			keep = fHeld[i]->id == want[k];
+		}
+		if (keep) {
+			i++;
+			continue;
+		}
+		sweet_fb_use(fHeld[i], -1);
+		fHeld[i]->release();
+		fHeld[i] = fHeld[--fHeldCount];
+	}
+	for (uint32_t k = 0; k < wanted; k++) {
+		bool held = false;
+		for (uint32_t i = 0; i < fHeldCount && !held; i++) {
+			held = fHeld[i]->id == want[k];
+		}
+		if (held || fHeldCount >= SWEET_FB_HELD) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(want[k]);
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		sweet_fb_use(s, 1);
+		fHeld[fHeldCount++] = s;
+	}
+}
