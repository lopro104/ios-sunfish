+#define UFS_DEVICE_WLUN 0xd0            /* UFS Device well-known LU, as UPIU LUN field */
+
+/* Set the device's Active power condition (START STOP UNIT to the device W-LU). */
+static void
+ufs_wake_device(void)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	static const uint8_t ssu[6] = { 0x1b, 0, 0, 0, 0x10, 0 };     /* POWER CONDITION 1: Active */
+	uint8_t lun = su.lun;
+	int error;
+
+	su.lun = UFS_DEVICE_WLUN;
+	/* Clear a pending unit attention on the W-LU first. */
+	for (int i = 0; i < 3 && ufs_scsi(tur, sizeof(tur), 0, false); i++) {
+	}
+	error = ufs_scsi(ssu, sizeof(ssu), 0, false);
+	su.lun = lun;
+	printf("SWEET UFS: START STOP UNIT (Active) to the device W-LU: %d\n", error);
+}
+
 static int
 ufs_find_partition(const char *want)
 {
@@ -646,13 +668,18 @@ sweet_ufs_init(void)
