 				    ufs_rd(REG_UTRLBAU), ufs_rd(REG_UTRLBA), ufs_rd(REG_UTRLRSR), ufs_rd(REG_UTRLDBR),
-				    sweet_ufs_last_fail.cmd, sweet_ufs_last_fail.timed_out ? " timed out" : "",
+				    sweet_ufs_last_fail.lun, sweet_ufs_last_fail.cmd, sweet_ufs_last_fail.timed_out ? " timed out" : "",
