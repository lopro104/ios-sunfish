+			 */
 			if (sweet_ufs_last_fail.key == 0x2) {
-				printf("SWEET UFS: unit not ready (asc 0x%x ascq 0x%x), starting it\n",
+				printf("SWEET UFS: unit not ready (asc 0x%x ascq 0x%x), waking the device\n",
 				    sweet_ufs_last_fail.asc, sweet_ufs_last_fail.ascq);
-				(void)ufs_scsi(start, sizeof(start), 0, false);
+				ufs_wake_device();
 			}
 			delay(50000);
 		}
