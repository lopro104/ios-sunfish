+
+/*
+ * PM6150 RTC (SID 0, rtc_rw at 0x6000; Linux rtc-pm8xxx.c pm8941_regs): ctrl
+ * 0x6046 bit 7 = counting, a little-endian 32-bit seconds count at
+ * 0x6048..0x604b. The low byte is read again afterwards and the count read
+ * a second time if it wrapped under us. Android cannot write this RTC on
+ * sunfish (qcom,qpnp-rtc-write = <0>): it keeps the wall clock as an offset
+ * in userspace, hence sweetrtc_offset (docs/SUNFISH.md says how to get it).
+ */
+bool
+SweetPlatformExpert::rtcRead(uint32_t *secs)
+{
+	uint8_t ctrl = 0, b[4], again = 0;
+
+	if (sweet_spmi_read(0, 0x6046, &ctrl) != 0 || !(ctrl & 0x80)) {
+		return false;
+	}
+	for (int attempt = 0; attempt < 2; attempt++) {
+		for (unsigned i = 0; i < 4; i++) {
+			if (sweet_spmi_read(0, 0x6048 + i, &b[i]) != 0) {
+				return false;
+			}
+		}
+		if (sweet_spmi_read(0, 0x6048, &again) != 0) {
+			return false;
+		}
+		if (again >= b[0]) {
+			break;
+		}
+	}
+	*secs = (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
 	return true;
 }
 
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint32_t raw;
+
+	if (!fRTC || !rtcRead(&raw)) {
+		return 0;
+	}
+	int64_t t = (int64_t)raw + fRTCOffset;
+	return t > 0 ? (long)t : 0;
+}
