+/*
+ * sunfish: the panel is a DSI command-mode panel, which the MDP only sends a
+ * frame to when told (sweet's video-mode panel is scanned continuously).
+ * shim/disp.c turns on the pingpong's autorefresh before XNU starts, which
+ * makes every TE pulse send the framebuffer. This is the fallback in case it
+ * did not take: autorefresh is set again here, and if a pingpong still has
+ * it off, the active CTL gets CTL_START after every frame the vsync timer
+ * copies in (the kickoff Linux's DPU driver issues per commit).
+ * SM7150 DPU catalog (dpu_5_2_sm7150.h): MDP at 0xae01000, CTL n at +0x1000 +
+ * 0x200 n, pingpong n at +0x70000 + 0x800 n.
+ */
+#define SWEET_MDP_BASE          0x0ae01000ULL
+#define SWEET_MDP_SIZE          0x72000
+#define SWEET_MDP_CTL(n)        (0x1000u + 0x200u * (n))
+#define SWEET_MDP_CTL_START     0x01c
+#define SWEET_MDP_CTL_INTF_ACTIVE 0x0f4
+#define SWEET_MDP_PP(n)         (0x70000u + 0x800u * (n))
+#define SWEET_MDP_PP_TEAR_CHECK_EN 0x000
+#define SWEET_MDP_PP_AUTOREFRESH 0x030
+#define SWEET_MDP_AUTOREFRESH_ON 0x80000001u      /* BIT(31) | every frame */
+
+static bool
+sweet_board_is(const char *want)
+{
+	IORegistryEntry *root = IORegistryEntry::getRegistryRoot();
+	OSData *compat = root ? OSDynamicCast(OSData, root->getProperty("compatible")) : NULL;
+	if (compat == NULL) {
+		return false;
+	}
+	const char *p = (const char *)compat->getBytesNoCopy();
+	unsigned int len = compat->getLength(), wl = (unsigned int)strlen(want);
+	for (unsigned int i = 0; i < len;) {
+		unsigned int n = 0;
+		while (i + n < len && p[i + n] != 0) {
+			n++;
+		}
+		if (n == wl && memcmp(p + i, want, n) == 0) {
+			return true;
+		}
+		i += n + 1;
+	}
+	return false;
+}
+
+void
+AppleCLCD::cmdModeSetup(void)
+{
+	int fallback = 1;
+
+	PE_parse_boot_argn("sweetfb_kick", &fallback, sizeof(fallback));
+	if (!fallback || !sweet_board_is("google,sunfish")) {
+		return;
+	}
+	fMDP = ml_io_map(SWEET_MDP_BASE, SWEET_MDP_SIZE);
+	if (fMDP == 0) {
+		IOLog("SWEET FB: cannot map the MDP; no command-mode fallback\n");
+		return;
+	}
+	volatile uint32_t *r = (volatile uint32_t *)fMDP;
+	bool needKick = false;
+	for (unsigned pp = 0; pp < 4; pp++) {
+		uint32_t base = SWEET_MDP_PP(pp) / 4;
+		if (!(r[base + SWEET_MDP_PP_TEAR_CHECK_EN / 4] & 1u)) {
+			continue;       /* not driving a command-mode panel */
+		}
+		uint32_t was = r[base + SWEET_MDP_PP_AUTOREFRESH / 4];
+		if (!(was & 0x80000000u)) {
+			r[base + SWEET_MDP_PP_AUTOREFRESH / 4] = SWEET_MDP_AUTOREFRESH_ON;
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+		uint32_t now = r[base + SWEET_MDP_PP_AUTOREFRESH / 4];
+		IOLog("SWEET FB: command-mode pingpong %u: autorefresh %#x -> %#x\n", pp, was, now);
+		if (!(now & 0x80000000u)) {
+			needKick = true;
+		}
+	}
+	if (!needKick) {
+		return;
+	}
+	for (unsigned ctl = 0; ctl < 6; ctl++) {
+		if (r[(SWEET_MDP_CTL(ctl) + SWEET_MDP_CTL_INTF_ACTIVE) / 4] != 0) {
+			fKickCTL = (int)ctl;
+			break;
+		}
+	}
+	IOLog("SWEET FB: autorefresh did not take; kicking CTL %d with CTL_START after each frame\n", fKickCTL);
+}
+
+void
+AppleCLCD::kick(void)
+{
+	if (fMDP == 0 || fKickCTL < 0) {
+		return;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");       /* the frame's pixels before the kickoff */
+	((volatile uint32_t *)fMDP)[(SWEET_MDP_CTL((unsigned)fKickCTL) + SWEET_MDP_CTL_START) / 4] = 1;
+}
