+/*
+ * The kernel half of the profiler (kern.sweetprof): while sweet_prof_target is set, every timer
+ * interrupt that finds one of that task's threads on the core keeps where it was, in the kernel
+ * (pc, lr and a few callers off its kernel stack) or in user space (pc, lr), for
+ * sweet_prof_dump() to print as "PRK cpu k|u pc lr callers...". The timer alone pops too seldom
+ * (40 samples in 30 s): sweet_prof_poke() interrupts the other cores as well, the profiler calls it
+ * every 2 ms.
+ */
+task_t sweet_prof_target;
+#define SWEET_PROF_RING         8192
+#define SWEET_PROF_FRAMES       8
+static struct {
+	uint64_t frame[SWEET_PROF_FRAMES];
+	uint32_t cpu, user;
+} sweet_prof_ring[SWEET_PROF_RING];
+static uint32_t sweet_prof_taken;
+
+void sweet_prof_tick(arm_saved_state_t *state);
+void sweet_prof_dump(void);
+void sweet_prof_poke(void);
+
+void
+sweet_prof_tick(arm_saved_state_t *state)
+{
+	thread_t thread = current_thread();
+	uint32_t i;
+
+	if (sweet_prof_target == TASK_NULL || get_threadtask(thread) != sweet_prof_target || !is_saved_state64(state)) {
+		return;
+	}
+	i = os_atomic_inc_orig(&sweet_prof_taken, relaxed);
+	if (i >= SWEET_PROF_RING) {
+		return;
+	}
+	bzero(&sweet_prof_ring[i], sizeof(sweet_prof_ring[i]));
+	sweet_prof_ring[i].cpu = cpu_number();
+	sweet_prof_ring[i].user = PSR64_IS_USER(get_saved_state_cpsr(state));
+	sweet_prof_ring[i].frame[0] = get_saved_state_pc(state);
+	sweet_prof_ring[i].frame[1] = get_saved_state_lr(state);
+	if (!sweet_prof_ring[i].user && thread->kernel_stack != 0) {
+		uint64_t fp = get_saved_state_fp(state), low = thread->kernel_stack, high = low + kernel_stack_size;
+
+		for (int f = 2; f < SWEET_PROF_FRAMES && fp >= low && fp + 16 <= high && (fp & 7) == 0; f++) {
+			sweet_prof_ring[i].frame[f] = VM_KERNEL_STRIP_PTR(((uint64_t *)fp)[1]);
+			if (((uint64_t *)fp)[0] <= fp) {
+				break;
+			}
+			fp = ((uint64_t *)fp)[0];
+		}
+	}
+}
+
+/* on each core, from the interrupt: what it interrupted (no state when called outside one) */
+static void
+sweet_prof_xcall(__unused void *arg)
+{
+	arm_saved_state_t *state = getCpuDatap()->cpu_int_state;
+
+	if (state != NULL) {
+		sweet_prof_tick(state);
+	}
+}
+
+void
+sweet_prof_poke(void)
+{
+	static int arg;
+
+	(void)cpu_broadcast_immediate_xcall(NULL, FALSE, sweet_prof_xcall, &arg);
+}
+
+/* after the run (sweet_prof_target cleared): the samples, 40 lines at a time for the console's stream */
+void
+sweet_prof_dump(void)
+{
+	uint32_t n = MIN(os_atomic_load(&sweet_prof_taken, relaxed), SWEET_PROF_RING);
+
+	printf("PRK --- %u samples, kernel slide 0x%lx\n", n, vm_kernel_slide);
+	for (uint32_t i = 0; i < n; i++) {
+		char line[300];
+		int used = snprintf(line, sizeof(line), "PRK %u %c", sweet_prof_ring[i].cpu, sweet_prof_ring[i].user ? 'u' : 'k');
+
+		for (int f = 0; f < SWEET_PROF_FRAMES && sweet_prof_ring[i].frame[f] != 0; f++) {
+			used += snprintf(line + used, sizeof(line) - used, " 0x%llx", sweet_prof_ring[i].frame[f]);
+		}
+		printf("%s\n", line);
+		if (i % 40 == 39) {
+			delay_for_interval(100, NSEC_PER_MSEC);
+		}
+	}
+	printf("PRK --- end\n");
+	os_atomic_store(&sweet_prof_taken, 0, relaxed);
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
