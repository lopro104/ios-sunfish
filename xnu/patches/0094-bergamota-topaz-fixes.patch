+	SweetSurfaceRef *ref = detachedFirst ? findRef(id, &index, true) : NULL;
+	if (ref == NULL) {
+		ref = findRef(id, &index);
+	}
 	if (ref != NULL && --ref->count == 0) {
-		fRefs->removeObject(index);     /* unmaps and drops the user count */
+		/*
+		 * After ios-topaz 0137: the pixels are unmapped now, the read-only state
+		 * page stays mapped for the last 256 released views (16 KB each, oldest
+		 * first out): in backboardd another IOSurface object can still hold a
