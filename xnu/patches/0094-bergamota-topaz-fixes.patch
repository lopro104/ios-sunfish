+/*
+ * After ios-topaz 0135/0136: IOSurfaceClientRelease calls trap 4 and then trap 5
+ * for one release, 4 under the framework's cache lock. 4 only marks the view
+ * (the framework is about to drop it); 5 drops it. A lookup between the two
+ * must get a view of its own (not "you have it already", -1): trap 5 then
+ * takes the detached view away, not the new one. Releasing at both traps
+ * dropped two references and unmapped surfaces still in use (backboardd
+ * crashed in IOSurfaceClientGetSeed reading an unmapped state page).
+ */
+IOReturn
+IOSurfaceRootUserClient::trapDetach(void *id, void *, void *, void *, void *, void *)
+{
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, NULL);
+	if (ref != NULL) {
+		ref->detached = true;
+	}
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+#define SWEET_SURFACE_ZOMBIES   256
+
+/* Trap 5: drop the detached view of id (else the live one). */
 IOReturn
 IOSurfaceRootUserClient::trapRelease(void *id, void *, void *, void *, void *, void *)
+{
+	return dropView((uint32_t)(uintptr_t)id, true);
+}
+
+/* Drop one count of a view of id: the detached one first if asked, else only the live one. */
