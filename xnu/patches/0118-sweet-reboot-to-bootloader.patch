+static int
+ufs_find_partition(const char *want)
+{
+	uint64_t first, count;
+	int error = ufs_lookup_partition(want, &first, &count);
+	if (error == 0) {
+		su.first_block = first;
+		su.nblocks = count;
+	}
+	return error;
