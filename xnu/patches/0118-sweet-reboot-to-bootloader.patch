 /* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+/*
+ * Make the next boot stop in the bootloader's fastboot, once: the bootloader message at the start
+ * of the misc partition gets the command "bootonce-bootloader" (Android's bootloader_message:
+ * command[32] first; bootloaders since Android 10 act on it and clear it). Called by
+ * SweetPlatformExpert::haltRestart just before the PSCI reset. Only the 32 command bytes of the
+ * one block are changed; this is the only write outside the root partition.
+ */
+int sweet_ufs_reboot_to_bootloader(void);
+
+int
+sweet_ufs_reboot_to_bootloader(void)
+{
+	static const char command[32] = "bootonce-bootloader";
+	uint64_t first = 0, count = 0;
+	uint8_t *b;
+	int error;
+
+	if (!su.ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_lookup_partition("misc", &first, &count);
+	if (error == 0 && (count == 0 || first > UINT32_MAX)) {
+		error = ENXIO;
+	}
+	if (error == 0) {
+		error = ufs_read_blocks(first, 1);
+	}
+	if (error == 0) {
+		b = (uint8_t *)(su.dma + DMA_BOUNCE);
+		printf("SWEET UFS: misc at block %llu (%llu blocks), command was \"%.32s\"\n", first, count, (const char *)b);
+		memcpy(b, command, sizeof(command));
+		uint8_t cdb[10] = {
+			0x2a, 0,
+			(uint8_t)(first >> 24), (uint8_t)(first >> 16), (uint8_t)(first >> 8), (uint8_t)first,
+			0, 0, 1, 0
+		};
+		error = ufs_scsi(cdb, sizeof(cdb), UFS_BLOCK, true);
+		if (error == 0) {
+			error = ufs_sync_cache();
+		}
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	printf("SWEET UFS: next boot to the bootloader: %d\n", error);
+	return error;
+}
