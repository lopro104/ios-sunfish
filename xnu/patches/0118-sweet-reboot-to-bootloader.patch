+/* PSCI SYSTEM_OFF / SYSTEM_RESET (SMCCC 1.0 through smc, as CPU_ON in SweetCPU); they do not return. */
+#define SWEET_PSCI_SYSTEM_OFF   0x84000008ULL
+#define SWEET_PSCI_SYSTEM_RESET 0x84000009ULL
+
+static void
+sweet_psci_call(uint64_t function)
+{
+	register uint64_t x0 __asm__("x0") = function;
+	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	    "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+}
+
+/*
+ * Restart and power off. There was no way to either: a reboot ended in "Halt/Restart Timed Out".
+ * A restart stops in the bootloader's fastboot by default (the bootloader message in misc, see
+ * sweet_ufs_reboot_to_bootloader), where the next test image is booted from; boot-arg
+ * sweet_reboot=normal restarts normally. Panics keep their screen (no reset), for the photo.
+ */
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	char how[16] = "";
+
+	switch (type) {
+	case kPERestartCPU:
+		PE_parse_boot_arg_str("sweet_reboot", how, sizeof(how));
+		if (strcmp(how, "normal") != 0) {
+			(void)sweet_ufs_reboot_to_bootloader();
+		}
+		IOLog("SWEET: PSCI SYSTEM_RESET\n");
+		IODelay(10000);
+		sweet_psci_call(SWEET_PSCI_SYSTEM_RESET);
+		break;
+	case kPEHaltCPU:
+		IOLog("SWEET: PSCI SYSTEM_OFF\n");
+		IODelay(10000);
+		sweet_psci_call(SWEET_PSCI_SYSTEM_OFF);
+		break;
+	default:
+		break;
+	}
+	return IODTPlatformExpert::haltRestart(type);
+}
