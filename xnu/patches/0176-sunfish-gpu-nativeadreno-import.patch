+/* The calling task's pages [address, address + bytes) as a buffer: wired here, until BoFree. */
+IOReturn
+SweetNativeAdrenoClient::boImport(const NativeAdrenoAbiBoImport * request, NativeAdrenoAbiBoAllocReply * reply)
+{
+	IOMemoryDescriptor * memory;
+	IOReturn ret;
+
+	if (request->address == 0 || (request->address & 4095) || request->bytes == 0 || (request->bytes & 4095) ||
+	    request->bytes > GPU_BUFFER_MAX || request->address + request->bytes < request->address) {
+		return kIOReturnBadArgument;
+	}
+	memory = IOMemoryDescriptor::withAddressRange((mach_vm_address_t) request->address, (mach_vm_size_t) request->bytes,
+	    kIODirectionInOut, current_task());
+	if (memory == NULL) {
+		return kIOReturnNoMemory;
+	}
+	ret = memory->prepare();
+	if (ret != kIOReturnSuccess) {
+		IOLog("SWEET GPU: NativeAdreno import of %llu bytes at %#llx: the pages cannot be wired (%#x)\n", request->bytes,
+		    request->address, ret);
+		memory->release();
+		return ret;
+	}
+	ret = addBuffer(memory, request->bytes, true, reply);
+	if (ret != kIOReturnSuccess) {
+		memory->complete();
+		memory->release();
+	}
+	return ret;
+}
