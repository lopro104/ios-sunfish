index 0000000..0e184f7
--- /dev/null
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -0,0 +1,729 @@
+/*
+ * SweetGPU: the Adreno 618 for programs to draw with.
+ *
+ * bsd/dev/sweet_adreno.c wakes the GPU and, with boot-arg adreno_keep=1 after all 21 of its
+ * steps, keeps it on and starts this service. A program that opens it speaks the interface of
+ * Linux's msm DRM driver, the one Mesa's freedreno knows: every request of that interface is a
+ * call of the user client with the request's number as the selector and the request's structure
+ * passed in and back. What Linux does with mmap() on the device is the client memory of the type
+ * that is the buffer's handle.
+ *
+ * Ported from HackiOS (OOSEX GANG, hackios-xnu-kernel branch "metal", iokit/Kernel/HKGPU.cpp,
+ * APSL 2.0), with the same request numbers and structures, so their userland half
+ * (hackios-xnu-userland tools/mesa/hackios-drm, which stands in for libdrm inside Mesa) works
+ * here with its service name changed to "SweetGPU". Left out for now: their cache of given-back
+ * buffers, their timing, reset of a hung core, and the display waiting for a surface the GPU is
+ * still drawing (the display shows what is there).
+ *
+ * What there is of the interface is what freedreno uses to draw: parameters, buffers (made, told
+ * their address in the GPU's address space, mapped, given back), submission of command buffers,
+ * and waiting for one to be done. A buffer is wired kernel memory entered into the 3D core's SMMU
+ * context, zero when made and write-combined, as Linux maps them for freedreno. One request is
+ * not Linux's: a buffer that is the memory of an IOSurface (SweetSurface.cpp), for drawing into
+ * what the display shows.
+ *
+ * Not here yet: interrupts (waiting is asking again five times a millisecond), and more than one
+ * program's worth of care: every client's buffers are in the one address space.
+ */
+#include "SweetSurface.h"
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOSubMemoryDescriptor.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <sys/systm.h>
+
+extern "C" {
+/* bsd/dev/sweet_adreno.c, "the GPU kept on" */
+bool sweet_gpu_ready(void);
+bool sweet_gpu_parameter(uint32_t which, uint64_t * value);
+uint64_t sweet_gpu_address(uint64_t size);
+void sweet_gpu_address_free(uint64_t address, uint64_t size);
+bool sweet_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void sweet_gpu_mapped(void);
+void sweet_gpu_unmap(uint64_t address, uint64_t size);
+void sweet_gpu_to_memory(void * start, uint64_t size);
+bool sweet_gpu_done(uint32_t fence);
+uint32_t sweet_gpu_last(void);
+uint32_t sweet_gpu_submit(const uint64_t * addresses, const uint32_t * words, uint32_t count);
+void sweet_gpu_report(const char * why);
+void SweetGPUStart(void);
+}
+
+/* Linux's include/uapi/drm/msm_drm.h and drm.h: the requests' numbers and structures (HackiOS's numbering). */
+enum {
+	kDrmGemClose            = 0x09,
+	kMsmGetParam            = 0x40,
+	kMsmSetParam            = 0x41,
+	kMsmGemNew              = 0x42,
+	kMsmGemInfo             = 0x43,
+	kMsmGemCpuPrep          = 0x44,
+	kMsmGemCpuFini          = 0x45,
+	kMsmGemSubmit           = 0x46,
+	kMsmWaitFence           = 0x47,
+	kMsmGemMadvise          = 0x48,
+	kMsmSubmitQueueNew      = 0x4a,
+	kMsmSubmitQueueClose    = 0x4b,
+	kMsmSubmitQueueQuery    = 0x4c,
+	kSweetSurface           = 0x7e,         /* ours (HackiOS's kHKSurface): an IOSurface's memory as a buffer */
+};
+
+struct msm_timespec {
+	int64_t seconds, nanoseconds;           /* of the clock that goes on while the machine sleeps */
+};
+struct msm_param {
+	uint32_t pipe, param;
+	uint64_t value;
+	uint32_t len, pad;
+};
+struct msm_gem_new {
+	uint64_t size;
+	uint32_t flags, handle;
+};
+struct msm_gem_info {
+	uint32_t handle, info;
+	uint64_t value;
+	uint32_t len, pad;
+};
+struct msm_gem_cpu_prep {
+	uint32_t handle, op;
+	struct msm_timespec timeout;
+};
+struct msm_gem_submit_cmd {
+	uint32_t type, submit_idx, submit_offset, size, pad, nr_relocs;
+	uint64_t relocs;
+};
+struct msm_gem_submit_bo {
+	uint32_t flags, handle;
+	uint64_t presumed;
+};
+struct msm_gem_submit {
+	uint32_t flags, fence, nr_bos, nr_cmds;
+	uint64_t bos, cmds;
+	int32_t fence_fd;
+	uint32_t queueid;
+	uint64_t in_syncobjs, out_syncobjs;
+	uint32_t nr_in_syncobjs, nr_out_syncobjs, syncobj_stride, pad;
+};
+struct msm_wait_fence {
+	uint32_t fence, flags;
+	struct msm_timespec timeout;
+	uint32_t queueid;
+};
+struct msm_gem_madvise {
+	uint32_t handle, madv, retained;
+};
+struct msm_submitqueue {
+	uint32_t flags, prio, id;
+};
+struct msm_submitqueue_query {
+	uint64_t data;
+	uint32_t id, param, len, pad;
+};
+struct drm_gem_close {
+	uint32_t handle, pad;
+};
+struct sweet_gpu_surface {
+	uint32_t surface;                       /* the IOSurface's ID */
+	uint32_t handle;                        /* kSweetDescribe: no buffer is wanted; else, back: the buffer, */
+	uint64_t size;                          /* how big it is, */
+	uint32_t offset, rowBytes;              /* where the pixels start in it and how long a row of them is, */
+	uint32_t width, height, pixelFormat, planes;    /* and what they are */
+};
+
+#define kSweetDescribe          0xffffffffu
+
+#define MSM_INFO_GET_OFFSET     0
+#define MSM_INFO_GET_IOVA       1
+#define MSM_INFO_SET_NAME       2
+#define MSM_INFO_GET_FLAGS      5
+#define MSM_BO_GPU_READONLY     0x00000002
+#define MSM_PREP_NOSYNC         0x04
+#define MSM_SUBMIT_CMD_BUF      1
+#define MSM_SUBMIT_FENCE_FD_OUT 0x20000000
+
+#define GPU_BUFFERS             4096            /* a client's, at most */
+#define GPU_BUFFER_MAX          (256u << 20)
+#define GPU_SUBMIT_CMDS         128
+#define GPU_SUBMIT_BOS          4096
+#define GPU_PATIENCE_MS         5000            /* for a buffer or a submission somebody waits for without a limit */
+#define GPU_ASK_AGAIN_US        200
+
+static IOLock * gGPULock;                       /* around everything that is the GPU's (sweet_gpu_...) */
+static bool gGPUReported;                       /* the core has stopped answering: nothing is waited for again */
+
+/* Wait for the 3D core to be done with submission `fence`; with the lock held, which is let go of while waiting. */
+static bool
+gpuWait(uint32_t fence, uint64_t milliseconds)
+{
+	uint64_t began = mach_absolute_time(), patience;
+
+	nanoseconds_to_absolutetime(milliseconds * NSEC_PER_MSEC, &patience);
+	for (;;) {
+		if (sweet_gpu_done(fence)) {
+			return true;
+		}
+		if (mach_absolute_time() - began >= patience || gGPUReported) {
+			break;
+		}
+		IOLockUnlock(gGPULock);
+		delay_for_interval(GPU_ASK_AGAIN_US, NSEC_PER_USEC);
+		IOLockLock(gGPULock);
+	}
+	/* a second or more for nothing: the core has stopped. Said once; a GPU that may yet write our memory gets nothing more */
+	if (milliseconds >= 1000 && !gGPUReported) {
+		sweet_gpu_report("no answer");
+		gGPUReported = true;
+	}
+	return false;
+}
+
+/* How long from now a time of msm's is, in milliseconds; 0: now or past. */
+static uint64_t
+millisecondsUntil(const struct msm_timespec * when)
+{
+	uint64_t now;
+	int64_t left;
+
+	absolutetime_to_nanoseconds(mach_continuous_time(), &now);
+	left = when->seconds * (int64_t) NSEC_PER_SEC + when->nanoseconds - (int64_t) now;
+	if (left <= 0) {
+		return 0;
+	}
+	return (uint64_t) left / NSEC_PER_MSEC > GPU_PATIENCE_MS ? GPU_PATIENCE_MS : (uint64_t) left / NSEC_PER_MSEC;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class SweetGPU : public IOService
+{
+	OSDeclareDefaultStructors(SweetGPU);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPU, IOService);
+
+bool
+SweetGPU::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "SweetGPUUserClient");
+	setName("SweetGPU");
+	registerService();
+	return true;
+}
+
+void
+SweetGPUStart(void)
+{
+	IOService * provider = IOService::getPlatform();
+	SweetGPU * gpu;
+
+	gGPULock = IOLockAlloc();
+	gpu = OSTypeAlloc(SweetGPU);
+	if (gpu == NULL || provider == NULL || gGPULock == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("SWEET GPU: cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		IOLog("SWEET GPU: the service did not start\n");
+	}
+	gpu->release();
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+struct gpu_buffer {
+	IOMemoryDescriptor *            memory;         /* NULL: this handle is free */
+	uint8_t *                       kernel;         /* where it is in the kernel */
+	SweetSurface *                  surface;        /* whose memory it is, when not its own */
+	uint64_t                        address;        /* the GPU's for it */
+	uint64_t                        size;
+	uint32_t                        flags;
+	uint32_t                        fence;          /* the last submission that names it (0: none has) */
+	bool                            seen;           /* mapped by the program, and so perhaps written through its cache */
+};
+
+class SweetGPUUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(SweetGPUUserClient);
+
+	struct gpu_buffer *     fBuffers;               /* handle n is fBuffers[n - 1] */
+	uint32_t                fNextQueue;
+	uint32_t                fNextBuffer;
+	uint32_t                fSubmits;
+
+	struct gpu_buffer * buffer(uint32_t handle);
+	struct gpu_buffer * newBuffer(IOMemoryDescriptor * memory, uint64_t size, uint32_t flags, uint32_t * handle);
+	void freeBuffer(struct gpu_buffer * b);
+	IOReturn gemNew(struct msm_gem_new * request);
+	IOReturn surfaceBuffer(struct sweet_gpu_surface * request);
+	IOReturn gemInfo(struct msm_gem_info * request);
+	IOReturn submit(struct msm_gem_submit * request);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPUUserClient, IOUserClient);
+
+bool
+SweetGPUUserClient::start(IOService * provider)
+{
+	if (!sweet_gpu_ready() || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fBuffers = IONewZero(struct gpu_buffer, GPU_BUFFERS);
+	return fBuffers != NULL;
+}
+
+/*
+ * With the lock held. The GPU is waited for if it may still be at the buffer (a second at most:
+ * HackiOS keeps such buffers aside instead, which saves a window server a few milliseconds a
+ * frame). One it never lets go of stays its own: it may yet be written, and must not be anybody
+ * else's memory by then.
+ */
+void
+SweetGPUUserClient::freeBuffer(struct gpu_buffer * b)
+{
+	bool busy = sweet_gpu_ready() && b->fence != 0 && !gpuWait(b->fence, 1000);
+
+	if (busy) {
+		static uint32_t said;
+
+		if (said++ < 8) {
+			IOLog("SWEET GPU: the GPU is not done with a buffer of %llu bytes: it stays its own\n", b->size);
+		}
+		/* (the memory and the surface are kept: references not dropped) */
+	} else {
+		if (sweet_gpu_ready()) {
+			sweet_gpu_unmap(b->address, b->size);
+			sweet_gpu_address_free(b->address, b->size);
+		}
+		b->memory->release();
+		OSSafeReleaseNULL(b->surface);
+	}
+	b->memory = NULL;
+	b->surface = NULL;
+}
+
+IOReturn
+SweetGPUUserClient::clientClose(void)
+{
+	if (fBuffers != NULL) {
+		IOLockLock(gGPULock);
+		if (sweet_gpu_ready()) {
+			gpuWait(sweet_gpu_last(), 1000);        /* what the client had the GPU do last may still be going on */
+		}
+		for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+			if (fBuffers[i].memory != NULL) {
+				freeBuffer(&fBuffers[i]);
+			}
+		}
+		IOLockUnlock(gGPULock);
+	}
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::free(void)
+{
+	if (fBuffers != NULL) {
+		IODelete(fBuffers, struct gpu_buffer, GPU_BUFFERS);
+		fBuffers = NULL;
+	}
+	IOUserClient::free();
+}
+
+struct gpu_buffer *
+SweetGPUUserClient::buffer(uint32_t handle)
+{
+	if (handle == 0 || handle > GPU_BUFFERS || fBuffers[handle - 1].memory == NULL) {
+		return NULL;
+	}
+	return &fBuffers[handle - 1];
+}
+
+/*
+ * A handle and addresses of the GPU's for `size` bytes of a memory descriptor (wired memory, in
+ * whole pages). With the lock held; NULL: there is no room. The caller fills in memory and kernel.
+ */
+struct gpu_buffer *
+SweetGPUUserClient::newBuffer(IOMemoryDescriptor * memory, uint64_t size, uint32_t flags, uint32_t * handle)
+{
+	struct gpu_buffer * b = NULL;
+	bool mapped = true;
+
+	for (uint32_t n = 0; n < GPU_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % GPU_BUFFERS;
+
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			*handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL || (b->address = sweet_gpu_address(size)) == 0) {
+		IOLog("SWEET GPU: no %s left for a buffer of %llu bytes\n", b ? "addresses" : "handles", size);
+		return NULL;
+	}
+	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && sweet_gpu_map(b->address + offset, phys, flags & MSM_BO_GPU_READONLY);
+	}
+	sweet_gpu_mapped();
+	if (!mapped) {
+		sweet_gpu_unmap(b->address, size);
+		sweet_gpu_address_free(b->address, size);
+		IOLog("SWEET GPU: a buffer of %llu bytes cannot be entered into the GPU's address space\n", size);
+		return NULL;
+	}
+	b->size = size;
+	b->flags = flags;
+	b->fence = 0;
+	b->seen = false;
+	b->surface = NULL;
+	return b;
+}
+
+IOReturn
+SweetGPUUserClient::gemNew(struct msm_gem_new * request)
+{
+	uint64_t size = round_page_64(request->size);
+	struct gpu_buffer * b;
+	IOBufferMemoryDescriptor * memory;
+
+	if (size == 0 || size > GPU_BUFFER_MAX) {
+		return kIOReturnBadArgument;
+	}
+	/* (the memory comes zeroed, and making it write-combined pushes the zeroes out of the cache) */
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared |
+	    kIOMapWriteCombineCache, (vm_size_t) size, PAGE_SIZE);
+	if (memory == NULL) {
+		IOLog("SWEET GPU: no memory for a buffer of %llu bytes\n", size);
+		return kIOReturnNoMemory;
+	}
+	IOLockLock(gGPULock);
+	b = newBuffer(memory, size, request->flags, &request->handle);
+	if (b != NULL) {
+		b->memory = memory;
+		b->kernel = (uint8_t *) memory->getBytesNoCopy();
+	}
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
+
+/*
+ * The memory of an IOSurface as a buffer: its pixels. The surface is held for as long as the
+ * buffer is there. A surface that is a buffer of this client's already is that buffer again, as
+ * with Linux's handles. Asked only to describe (kSweetDescribe), no buffer is made.
+ */
+IOReturn
+SweetGPUUserClient::surfaceBuffer(struct sweet_gpu_surface * request)
+{
+	SweetSurface * s = sweet_surface_copy(request->surface);
+	struct gpu_buffer * b = NULL;
+	uint64_t size;
+
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	size = round_page_64(s->allocSize);
+	if (s->memory == NULL || size == 0 || size > GPU_BUFFER_MAX || s->memory->getLength() < size) {
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	request->size = size;
+	request->offset = s->offset;
+	request->rowBytes = s->bytesPerRow;
+	request->width = s->width;
+	request->height = s->height;
+	request->pixelFormat = s->pixelFormat;
+	request->planes = s->planeCount;
+	if (request->handle == kSweetDescribe) {
+		request->handle = 0;
+		s->release();
+		return kIOReturnSuccess;
+	}
+
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			break;
+		}
+	}
+	if (b != NULL) {
+		s->release();
+	} else if ((b = newBuffer(s->memory, size, 0, &request->handle)) != NULL) {
+		s->memory->retain();
+		b->memory = s->memory;
+		b->kernel = (uint8_t *) s->kernelAddress();
+		b->surface = s;
+	} else {
+		s->release();
+	}
+	IOLockUnlock(gGPULock);
+	return b != NULL ? kIOReturnSuccess : kIOReturnNoMemory;
+}
+
+IOReturn
+SweetGPUUserClient::gemInfo(struct msm_gem_info * request)
+{
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(gGPULock);
+	b = buffer(request->handle);
+	if (b == NULL) {
+		ret = kIOReturnBadArgument;
+	} else if (request->info == MSM_INFO_GET_OFFSET) {
+		request->value = (uint64_t) request->handle << 32;      /* nobody maps by it here */
+	} else if (request->info == MSM_INFO_GET_IOVA) {
+		request->value = b->address;    /* the buffer's until it is given back: nothing moves a live buffer */
+	} else if (request->info == MSM_INFO_GET_FLAGS) {
+		request->value = b->flags;
+	} else if (request->info != MSM_INFO_SET_NAME) {        /* SET_IOVA among them: addresses are the kernel's to give */
+		ret = kIOReturnUnsupported;
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::submit(struct msm_gem_submit * request)
+{
+	struct msm_gem_submit_bo * bos = NULL;
+	struct msm_gem_submit_cmd * cmds = NULL;
+	uint64_t addresses[GPU_SUBMIT_CMDS];
+	uint32_t words[GPU_SUBMIT_CMDS], count = 0;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (request->nr_cmds == 0 || request->nr_cmds > GPU_SUBMIT_CMDS || request->nr_bos == 0 || request->nr_bos > GPU_SUBMIT_BOS) {
+		return kIOReturnBadArgument;
+	}
+	bos = IONew(struct msm_gem_submit_bo, request->nr_bos);
+	cmds = IONew(struct msm_gem_submit_cmd, request->nr_cmds);
+	if (bos == NULL || cmds == NULL) {
+		ret = kIOReturnNoMemory;
+		goto out;
+	}
+	if (copyin((user_addr_t) request->bos, bos, request->nr_bos * sizeof(*bos)) != 0 ||
+	    copyin((user_addr_t) request->cmds, cmds, request->nr_cmds * sizeof(*cmds)) != 0) {
+		ret = kIOReturnVMError;
+		goto out;
+	}
+	IOLockLock(gGPULock);
+	/*
+	 * The GPU reads and writes memory, not this processor's cache. Surfaces are ordinary cached
+	 * memory, which others (the display, programs that draw with the processor) write: each one
+	 * named goes out of the cache before the core sees it (HackiOS does this once a frame or when
+	 * its seed changes; this is the simple, slower form). The buffers made here are write-combined
+	 * and need none of it.
+	 */
+	for (uint32_t i = 0; i < request->nr_bos; i++) {
+		struct gpu_buffer * b = buffer(bos[i].handle);
+
+		if (b != NULL && b->surface != NULL && b->kernel != NULL) {
+			sweet_gpu_to_memory(b->kernel, b->size);
+		}
+	}
+	sweet_gpu_to_memory(NULL, 0);           /* (and what was written last is in memory: a barrier) */
+	for (uint32_t i = 0; i < request->nr_cmds; i++) {
+		struct gpu_buffer * b = cmds[i].submit_idx < request->nr_bos ? buffer(bos[cmds[i].submit_idx].handle) : NULL;
+
+		if (cmds[i].type != MSM_SUBMIT_CMD_BUF) {
+			continue;                       /* the other kinds are for a GPU shared between address spaces */
+		}
+		if (b == NULL || cmds[i].nr_relocs != 0 || (cmds[i].size & 3) || (cmds[i].submit_offset & 3) ||
+		    (uint64_t) cmds[i].submit_offset + cmds[i].size > b->size) {
+			IOLog("SWEET GPU: command buffer %u of a submission: buffer %u, offset %u, %u bytes, %u relocations: not taken\n",
+			    i, cmds[i].submit_idx, cmds[i].submit_offset, cmds[i].size, cmds[i].nr_relocs);
+			IOLockUnlock(gGPULock);
+			goto out;
+		}
+		addresses[count] = b->address + cmds[i].submit_offset;
+		words[count++] = cmds[i].size / 4;
+	}
+	request->fence = count == 0 || gGPUReported ? 0 : sweet_gpu_submit(addresses, words, count);
+	if (request->fence == 0 && count != 0 && !gGPUReported) {
+		sweet_gpu_report("the ring is full");
+		gGPUReported = true;
+	}
+	if (request->flags & MSM_SUBMIT_FENCE_FD_OUT) {
+		request->fence_fd = -1;
+	}
+	for (uint32_t i = 0; request->fence != 0 && i < request->nr_bos; i++) {
+		struct gpu_buffer * b = buffer(bos[i].handle);
+
+		if (b != NULL) {
+			b->fence = request->fence;
+		}
+	}
+	if (request->fence != 0 && fSubmits++ < 4) {
+		IOLog("SWEET GPU: submission %u: %u command buffers, the first at %#llx, %u words\n", request->fence, count,
+		    addresses[0], words[0]);
+	}
+	IOLockUnlock(gGPULock);
+	ret = request->fence != 0 ? kIOReturnSuccess : kIOReturnTimeout;
+out:
+	if (bos != NULL) {
+		IODelete(bos, struct msm_gem_submit_bo, request->nr_bos);
+	}
+	if (cmds != NULL) {
+		IODelete(cmds, struct msm_gem_submit_cmd, request->nr_cmds);
+	}
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gGPULock);
+	b = buffer(type);
+	if (b != NULL) {
+		b->memory->retain();
+		b->seen = true;
+		*memory = b->memory;
+		*options = 0;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	union {
+		struct msm_param param;
+		struct msm_gem_new gemNew;
+		struct msm_gem_info gemInfo;
+		struct msm_gem_cpu_prep cpuPrep;
+		struct msm_gem_submit submit;
+		struct msm_wait_fence waitFence;
+		struct msm_gem_madvise madvise;
+		struct msm_submitqueue queue;
+		struct msm_submitqueue_query query;
+		struct drm_gem_close close;
+		struct sweet_gpu_surface surface;
+	} r;
+	size_t size = args->structureInputSize;
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t zero = 0, patience;
+
+	(void) dispatch;
+	(void) target;
+	(void) reference;
+	if (args->structureInput == NULL || size > sizeof(r) || fBuffers == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!sweet_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	bzero(&r, sizeof(r));
+	memcpy(&r, args->structureInput, size);
+
+	switch (selector) {
+	case kMsmGetParam:
+		ret = sweet_gpu_parameter(r.param.param, &r.param.value) ? kIOReturnSuccess : kIOReturnBadArgument;
+		break;
+	case kMsmSetParam:                      /* the program's name, for Linux's lists of who uses the GPU */
+	case kMsmGemCpuFini:
+	case kMsmSubmitQueueClose:
+		break;
+	case kMsmGemNew:
+		ret = gemNew(&r.gemNew);
+		break;
+	case kMsmGemInfo:
+		ret = gemInfo(&r.gemInfo);
+		break;
+	case kMsmGemCpuPrep:                    /* is the GPU done with a buffer: with all it has been given, here */
+		IOLockLock(gGPULock);
+		patience = (r.cpuPrep.op & MSM_PREP_NOSYNC) ? 0 : millisecondsUntil(&r.cpuPrep.timeout);
+		if (!gpuWait(sweet_gpu_last(), patience)) {
+			ret = kIOReturnBusy;
+		}
+		IOLockUnlock(gGPULock);
+		break;
+	case kMsmGemSubmit:
+		ret = submit(&r.submit);
+		break;
+	case kMsmWaitFence:
+		IOLockLock(gGPULock);
+		if (!gpuWait(r.waitFence.fence, millisecondsUntil(&r.waitFence.timeout))) {
+			ret = kIOReturnTimeout;
+		}
+		IOLockUnlock(gGPULock);
+		break;
+	case kMsmGemMadvise:
+		r.madvise.retained = 1;
+		break;
+	case kMsmSubmitQueueNew:
+		r.queue.id = ++fNextQueue;
+		break;
+	case kMsmSubmitQueueQuery:              /* how often the GPU has faulted on this client's commands */
+		if (r.query.data != 0 && r.query.len >= sizeof(zero)) {
+			(void) copyout(&zero, (user_addr_t) r.query.data, sizeof(zero));
+		}
+		break;
+	case kDrmGemClose:
+		IOLockLock(gGPULock);
+		b = buffer(r.close.handle);
+		if (b == NULL) {
+			ret = kIOReturnBadArgument;
+		} else {
+			freeBuffer(b);
+		}
+		IOLockUnlock(gGPULock);
+		break;
+	case kSweetSurface:
+		ret = surfaceBuffer(&r.surface);
+		break;
+	default:
+		IOLog("SWEET GPU: request %#x (%zu bytes) is not known here\n", selector, size);
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	if (ret == kIOReturnSuccess && args->structureOutput != NULL) {
+		if (args->structureOutputSize > size) {
+			args->structureOutputSize = (uint32_t) size;
+		}
+		memcpy(args->structureOutput, &r, args->structureOutputSize);
+	}
+	return ret;
+}
+#endif /* SWEET */
