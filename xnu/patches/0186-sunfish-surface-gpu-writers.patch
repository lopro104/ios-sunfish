+/* Has a layer surface of this swap GPU work still drawing into it (SweetSurface gpuWriters, from the Metal client)? */
+static bool
+sweet_fb_swap_busy(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+	bool busy = false;
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS && !busy; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (s != NULL) {
+			busy = s->gpuWriters > 0;
+			s->release();
+		}
+	}
+	return busy;
+}
