+/*
+ * kern.sweet_surface_gpu (bsd/dev/sweet_sample.c): a Metal client (SweetMetal's frontend) says that GPU
+ * work drawing into surface `value` was committed (value > 0) or has completed (value = -id). The
+ * display does not copy a surface with work outstanding (SweetFramebuffer.cpp): Core Animation swaps
+ * before that work is done, and the panel showed frames being drawn.
+ */
+extern "C" int
+sweet_surface_gpu(int value)
+{
+	uint32_t id = (uint32_t)(value < 0 ? -value : value);
+	SweetSurface *s = sweet_surface_copy(id);
+
+	if (s == NULL) {
+		return ENOENT;
+	}
+	if (value > 0) {
+		OSIncrementAtomic(&s->gpuWriters);
+	} else {
+		SInt32 now = s->gpuWriters;
+		while (now > 0 && !OSCompareAndSwap((UInt32)now, (UInt32)(now - 1), (volatile UInt32 *)&s->gpuWriters)) {
+			now = s->gpuWriters;
+		}
+	}
+	s->release();
+	return 0;
+}
+
 SweetSurface *
 sweet_surface_copy(uint32_t id)
 {
--- a/bsd/dev/sweet_sample.c	2026-10-29 21:17:55.009544426 +0200
+++ b/bsd/dev/sweet_sample.c	2026-10-29 21:17:55.019961679 +0200
@@ -125,6 +125,27 @@
 	return error;
 }
 
+/*
+ * kern.sweet_surface_gpu=ID (+1) or -ID (-1), anybody: GPU work drawing into IOSurface ID was committed /
+ * has completed (iokit/Kernel/arm/SweetSurface.cpp sweet_surface_gpu; written by SweetMetal's frontend).
+ */
+extern int sweet_surface_gpu(int value);
+
+static int
+sysctl_sweet_surface_gpu(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int value = 0;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	return value == 0 ? EINVAL : sweet_surface_gpu(value);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_surface_gpu, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_surface_gpu, "I", "GPU work into an IOSurface: id committed, -id completed");
