+/* Whether the ADT root's compatible list names `want` (as SweetFramebuffer.cpp asks). */
+bool
+SweetBattery::boardIs(const char *want)
+{
+	IORegistryEntry *root = IORegistryEntry::getRegistryRoot();
+	OSData *compat = root ? OSDynamicCast(OSData, root->getProperty("compatible")) : NULL;
+	if (compat == NULL) {
+		return false;
+	}
+	const char *p = (const char *)compat->getBytesNoCopy();
+	unsigned int len = compat->getLength(), wl = (unsigned int)strlen(want);
+	for (unsigned int i = 0; i < len;) {
+		unsigned int n = 0;
+		while (i + n < len && p[i + n] != 0) {
+			n++;
+		}
+		if (n == wl && memcmp(p + i, want, n) == 0) {
+			return true;
+		}
+		i += n + 1;
+	}
+	return false;
+}
