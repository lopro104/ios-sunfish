diff --git a/iokit/Kernel/arm/SweetWiFi.cpp b/iokit/Kernel/arm/SweetWiFi.cpp
--- a/iokit/Kernel/arm/SweetWiFi.cpp
+++ b/iokit/Kernel/arm/SweetWiFi.cpp
@@ -1,12 +1,14 @@
 /*
- * IO80211Interface stand-in for the Wi-Fi interface ew0 (bsd/dev/sweet_mpss.c).
+ * IO80211Interface stand-in for the Wi-Fi interface (bsd/dev/sweet_mpss.c).
  *
- * Apple's IO80211 library (Apple80211GetIfListCopy / Apple80211BindToInterface, used by wifid, MobileWiFi,
- * and through them Settings) finds an interface by getifaddrs + SIOCGIFMEDIA (media type IEEE 802.11) and then
- * looks up its IORegistry entry with IOServiceGetMatchingService({IOPropertyMatch: {IOInterfaceName: "ew0"}}),
- * reading "IO80211InterfaceRole" ("Infrastructure"). With no IO80211Controller in the registry it falls back to
- * plain SIOCGA80211/SIOCSA80211 ioctls on the interface, which sweet_mpss.c answers. So this service only has to
- * exist, carry those properties, and be registered.
+ * SystemConfiguration's SCNetworkInterfaceCopyAll looks for services matching
+ * "IONetworkInterface", and checks if their parent conforms to "IO80211Controller"
+ * (or AirPortPCI / AirPortDriver). When both match, SC assigns type "IEEE80211".
+ *
+ * Apple's IO80211 library (Apple80211GetIfListCopy / Apple80211BindToInterface,
+ * used by wifid, MobileWiFi, and Settings) looks up the IORegistry entry with
+ * IOServiceGetMatchingService({IOPropertyMatch: {IOInterfaceName: ifname}}),
+ * reading "IO80211InterfaceRole" ("Infrastructure").
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <device/device_types.h> /* io_buf_ptr_t for private OSKext headers */
@@ -17,28 +19,50 @@
