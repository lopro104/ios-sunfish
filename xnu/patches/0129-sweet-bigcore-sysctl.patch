--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -64,6 +64,32 @@
 extern void sweet_prof_poke(void);
 static char sweet_prof_proc[32] = "backboardd";
 
+/*
+ * kern.sweet_bigcore=N: the calling thread binds itself to core N, one of sunfish's two A76s (6
+ * or 7; -1 unbinds). The kernel takes the eight cores as the same and leaves CoreAnimation's
+ * drawing thread on the A55s (94% of the profiler's samples); the GL layer in backboardd (glbig=N)
+ * asks for this. kern.sched_thread_bind_cpu does the same for root only, and backboardd is not.
+ */
+extern kern_return_t sysctl_thread_bind_cpuid(int32_t cpuid);
+
+static int
+sysctl_sweet_bigcore SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = -1, changed = 0;
+	int error = sysctl_io_number(req, -1, sizeof(value), &value, &changed);
+
+	if (error != 0 || !changed) {
+		return error;
+	}
+	if (value != -1 && value != 6 && value != 7) {
+		return EINVAL;
+	}
+	return sysctl_thread_bind_cpuid(value) == KERN_SUCCESS ? 0 : ERANGE;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_bigcore, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_bigcore, "I", "bind the calling thread to big core N (6, 7; -1 unbinds)");
+
 static int
 sweet_prof_find(proc_t p, __unused void *arg)
 {
