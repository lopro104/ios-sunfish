+/* What the UI shows: toward raw by at most 1% per 20 s, never up while discharging nor down while charging. */
+unsigned
+SweetBattery::smoothPercent(unsigned raw, int ma, uint64_t now)
+{
+	if (fSoc < 0) {
+		fSoc = (int)raw;
+		fSocTime = now;
+		return raw;
+	}
+	int diff = (int)raw - fSoc;
+	if (diff == 0 || (diff > 0 && ma < -10) || (diff < 0 && ma > 10)) {
+		fSocTime = now;
+		return (unsigned)fSoc;
+	}
+	int64_t steps = (int64_t)(now - fSocTime) / 20000;
+	if (steps == 0) {
+		return (unsigned)fSoc;
+	}
+	if (diff > steps) {
+		diff = (int)steps;
+	} else if (diff < -steps) {
+		diff = -(int)steps;
+	}
+	fSoc += diff;
+	fSocTime += (uint64_t)steps * 20000;
+	return (unsigned)fSoc;
+}
