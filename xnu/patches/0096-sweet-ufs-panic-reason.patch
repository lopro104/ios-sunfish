diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b39f74..a4de944 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -148,6 +148,11 @@ dma_clean(uint32_t off, uint32_t len)
  * One SCSI command in slot 0, data (if any) to/from the bounce buffer
  * (to the device when write is set). Returns 0 or an errno.
  */
+static struct {
+	uint32_t cmd, ocs, upiu, resp, status;
+	bool timed_out;
+} sweet_ufs_last_fail;
+
 static int
 ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 {
@@ -223,6 +228,8 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 		uint64_t now = mach_absolute_time();
 		if (now > deadline) {
 			ufs_wr(REG_UTRLCLR, ~1u);
+			sweet_ufs_last_fail.cmd = cdb[0];
+			sweet_ufs_last_fail.timed_out = true;
 			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
 			return ETIMEDOUT;
 		}
@@ -252,6 +259,11 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 
 	uint32_t ocs = utrd->dw2 & 0xff;
 	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		sweet_ufs_last_fail.cmd = cdb[0];
+		sweet_ufs_last_fail.ocs = ocs;
+		sweet_ufs_last_fail.upiu = ucd->resp[0];
+		sweet_ufs_last_fail.resp = ucd->resp[6];
+		sweet_ufs_last_fail.status = ucd->resp[7];
 		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
 		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
 		return EIO;
@@ -820,6 +832,20 @@ sweet_ufs_rootdev(dev_t *dev)
 	if (!su.ready) {
 		int error = sweet_ufs_init();
 		if (error) {
+			/*
+			 * The console lines that say why scroll away before the panic
+			 * screen draws, so put the cause into the panic string itself.
+			 */
+			if (su.regs) {
+				panic("SWEET UFS init failed: error %d; hce 0x%x hcs 0x%x is 0x%x cap 0x%x "
+				    "utrlba 0x%x:%x rsr 0x%x dbr 0x%x; last cmd 0x%02x%s ocs 0x%x upiu 0x%x "
+				    "resp 0x%x status 0x%x; dma 0x%llx",
+				    error, ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_IS), ufs_rd(REG_CAP),
+				    ufs_rd(REG_UTRLBAU), ufs_rd(REG_UTRLBA), ufs_rd(REG_UTRLRSR), ufs_rd(REG_UTRLDBR),
+				    sweet_ufs_last_fail.cmd, sweet_ufs_last_fail.timed_out ? " timed out" : "",
+				    sweet_ufs_last_fail.ocs, sweet_ufs_last_fail.upiu, sweet_ufs_last_fail.resp,
+				    sweet_ufs_last_fail.status, su.dma_pa);
+			}
 			return error;
 		}
 	}
