 	if (!error) {
-		error = rh_send(address, mv);
+		/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+		const uint32_t addresses[3] = {address, address + 8, address + 4};
+		const uint32_t values[3] = {mv, 7, 1};
+		error = rh_send(addresses, values, 3, "L11C");
 	}
 out:
 	if (error) {
@@ -355,4 +373,53 @@ out:
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+
+#define BCM_COMMIT      (1u << 30)
+#define BCM_VALID       (1u << 29)
+#define BCM_VOTE(x, y)  (BCM_COMMIT | BCM_VALID | ((uint32_t)(x) & 0x3fffu) << 14 | ((uint32_t)(y) & 0x3fffu))
+#define BCM_ACV_APPS    8u
+
+/*
+ * The memory bandwidth vote: `vote` (1..16383, in the BCMs' own units; 16383 the most) as average and
+ * peak on MC0 and SH0, and ACV's bit for the application processor. send=false only looks the BCMs up
+ * in cmd-db and says where they are.
+ */
+int
+sweet_rpmh_ddr_vote(uint32_t vote, bool send)
+{
+	uint32_t mc0 = 0, sh0 = 0, acv = 0;
+	int error;
+
+	if (vote == 0 || vote > 0x3fffu) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	error = EIO;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup("MC0", RH_BCM, &mc0);
+	}
+	if (!error) {
+		error = rh_lookup("SH0", RH_BCM, &sh0);
+	}
+	if (!error) {
+		error = rh_lookup("ACV", RH_BCM, &acv);
+	}
+	if (!error && send) {
+		const uint32_t addresses[3] = {mc0, sh0, acv};
+		const uint32_t values[3] = {BCM_VOTE(vote, vote), BCM_VOTE(vote, vote), BCM_VOTE(0, BCM_ACV_APPS)};
+		error = rh_send(addresses, values, 3, "DDR bandwidth");
+	}
+out:
+	printf("SWEET RPMH: DDR bandwidth %s %u on MC0 %#x, SH0 %#x, ACV %#x: %s (errno %d)\n",
+	    send ? "vote" : "look-up for a vote of", vote, mc0, sh0, acv, error ? "FAILED" : "ok", error);
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index bf4e518..65cff75 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -89,12 +89,12 @@ int
 sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
 	/* Restrict access to the battery blocks, the sunfish touch switch
-	 * (PM6150 GPIO4) and the RTC (0x60); keys retain their own lanes. */
+	 * (PM6150 GPIO4), the RTC (0x60) and the ADC5 (0x31); keys retain their own lanes. */
 	unsigned peripheral = addr >> 8;
 	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
 	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
 	    peripheral != 0x13 && peripheral != 0x48 && peripheral != 0xc3 &&
-	    peripheral != 0x60)) {
+	    peripheral != 0x60 && peripheral != 0x31)) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
@@ -130,14 +130,15 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 
 /*
  * SUNFISH: the in-cell FTM5 touch IC sits behind a load switch on PM6150
- * GPIO4 (downstream pinctrl touch_power_default: output high). That pin is
- * the only PMIC state any SWEET driver changes; the address check below
+ * GPIO4 (downstream pinctrl touch_power_default: output high), and the
+ * battery's temperature is a conversion of the PM6150's ADC5 (below). Those
+ * are the only PMIC registers any SWEET driver writes; the address check
  * keeps every other peripheral read-only.
  */
 int
 sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
 {
-	if (!sp_ready || sid != 0 || addr < 0xc340u || addr > 0xc346u) {
+	if (!sp_ready || sid != 0 || !((addr >= 0xc340u && addr <= 0xc346u) || (addr >= 0x3142u && addr <= 0x3147u))) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
@@ -175,4 +176,111 @@ sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+
+/*
+ * The battery's temperature: one conversion of the PM6150's ADC5 (SID 0, 0x3100; linux pm6150.dtsi
+ * adc@3100, channel bat_therm@4a = ADC5_BAT_THERM_100K_PU, ratiometric, hw-settle 200 us), as
+ * drivers/iio/adc/qcom-spmi-adc5.c does it: registers 0x42..0x46 (digital parameters, averaging,
+ * channel, settle time, enable), then the conversion request 0x47, wait for end of conversion in
+ * STATUS1, read DATA0/1; the code to a voltage over the 1.875 V reference (full scale 0x70e4) and the
+ * voltage to a temperature through the 100k NTC table (qcom-vadc-common.c
+ * adcmap_100k_104ef_104fb_1875_vref). The same values Android's driver writes; nothing else in the
+ * ADC is touched.
+ */
+#define ADC5_BASE               0x3100u
+#define ADC5_STATUS1            0x08u
+#define ADC5_STATUS1_FAULT      0x80u
+#define ADC5_STATUS1_EOC        0x01u
+#define ADC5_STATUS1_REQ_EOC    0x03u
+#define ADC5_DIG_PARAM          0x42u
+#define ADC5_CONV_REQ           0x47u
+#define ADC5_DATA0              0x50u
+#define ADC5_CH_BAT_THERM       0x4au
+#define ADC5_FULL_SCALE         0x70e4
+#define ADC5_MAX_CODE           0x7fff
+
+static const struct adc5_ntc_point {
+	int millivolt;
+	int millideg;
+} adc5_ntc_100k[] = {
+	{ 1831, -40000 }, { 1814, -35000 }, { 1791, -30000 }, { 1761, -25000 }, { 1723, -20000 },
+	{ 1675, -15000 }, { 1616, -10000 }, { 1545, -5000 }, { 1463, 0 }, { 1370, 5000 },
+	{ 1268, 10000 }, { 1160, 15000 }, { 1049, 20000 }, { 937, 25000 }, { 828, 30000 },
+	{ 726, 35000 }, { 630, 40000 }, { 544, 45000 }, { 467, 50000 }, { 399, 55000 },
+	{ 340, 60000 }, { 290, 65000 }, { 247, 70000 }, { 209, 75000 }, { 179, 80000 },
+	{ 153, 85000 }, { 130, 90000 }, { 112, 95000 }, { 96, 100000 }, { 82, 105000 },
+	{ 71, 110000 }, { 62, 115000 }, { 53, 120000 }, { 46, 125000 },
+};
+
+int
+sweet_spmi_battery_temp(int *tenths)
+{
+	static uint32_t failures;
+	uint8_t reg[5], status = 0, lo = 0, hi = 0;
+	int mv = 0, mdeg;
+	unsigned n = sizeof(adc5_ntc_100k) / sizeof(adc5_ntc_100k[0]), i = 0;
+
+	if (!tenths || failures > 3) {
+		return -1;
+	}
+	/* 0x42..0x46 as they are, then the bits qcom-spmi-adc5.c adc5_configure() sets */
+	for (unsigned r = 0; r < 5; r++) {
+		if (sweet_spmi_read(0, ADC5_BASE + ADC5_DIG_PARAM + r, &reg[r]) != 0) {
+			goto fail;
+		}
+	}
+	reg[0] = (uint8_t)((reg[0] & ~0x7cu) | (1u << 4) | (2u << 2)); /* timer cal, ratiometric, decimation 840 */
+	reg[1] = (uint8_t)(reg[1] & ~0x07u);                           /* one sample */
+	reg[2] = ADC5_CH_BAT_THERM;
+	reg[3] = (uint8_t)((reg[3] & ~0x0fu) | 2u);                    /* hw settle 200 us */
+	reg[4] = (uint8_t)(reg[4] | 0x80u);                            /* ADC enabled */
+	for (unsigned r = 0; r < 5; r++) {
+		if (sweet_spmi_write(0, ADC5_BASE + ADC5_DIG_PARAM + r, reg[r]) != 0) {
+			goto fail;
+		}
+	}
+	if (sweet_spmi_write(0, ADC5_BASE + ADC5_CONV_REQ, 0x80u) != 0) {
+		goto fail;
+	}
+	for (unsigned t = 0; t < 100; t++) {
+		delay(100);
+		if (sweet_spmi_read(0, ADC5_BASE + ADC5_STATUS1, &status) != 0) {
+			goto fail;
+		}
+		if ((status & ADC5_STATUS1_REQ_EOC) == ADC5_STATUS1_EOC) {
+			break;
+		}
+	}
+	if ((status & ADC5_STATUS1_REQ_EOC) != ADC5_STATUS1_EOC || (status & ADC5_STATUS1_FAULT) ||
+	    sweet_spmi_read(0, ADC5_BASE + ADC5_DATA0, &lo) != 0 ||
+	    sweet_spmi_read(0, ADC5_BASE + ADC5_DATA0 + 1, &hi) != 0) {
+		goto fail;
+	}
+	unsigned code = (unsigned)lo | (unsigned)hi << 8;
+	if (code > ADC5_MAX_CODE) {
+		code = 0;
+	}
+	mv = (int)((uint64_t)code * 1875 / ADC5_FULL_SCALE);
+	while (i < n && adc5_ntc_100k[i].millivolt > mv) {
+		i++;
+	}
+	if (i == 0 || i == n) {
+		/* off the table: an open (below -40 C) or shorted (above 125 C) thermistor, not a battery */
+		printf("SWEET BATTERY: ADC5 bat_therm %d mV is off the thermistor table; ignored\n", mv);
+		goto fail;
+	} else {
+		/* linear between the two points (fixp_linear_interpolate) */
+		int x0 = adc5_ntc_100k[i - 1].millivolt, y0 = adc5_ntc_100k[i - 1].millideg;
+		int x1 = adc5_ntc_100k[i].millivolt, y1 = adc5_ntc_100k[i].millideg;
+		mdeg = y0 + (y1 - y0) * (mv - x0) / (x1 - x0);
+	}
+	*tenths = mdeg / 100;
+	failures = 0;
+	return 0;
+fail:
+	if (++failures > 3) {
+		printf("SWEET BATTERY: ADC5 battery temperature fails (status %#x); not asked again\n", status);
+	}
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
