 IOReturn
-IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
-    void *, void *, void *, void *)
+IOSurfaceRootUserClient::useCount(uint32_t id, bool increment)
 {
-	return kIOReturnSuccess;
+	IOReturn ret = kIOReturnNotFound;
+
+	IOLockLock(fLock);
+	for (unsigned int i = 0; i < fRefs->getCount(); i++) {
+		SweetSurfaceRef *ref = (SweetSurfaceRef *)fRefs->getObject(i);
+		if (ref->surface->id != id) {
+			continue;
+		}
+		if (increment) {
+			ref->uses++;
+			sweet_surface_use(ref->surface, 1);
+		} else if (ref->uses != 0) {
+			ref->uses--;
+			sweet_surface_use(ref->surface, -1);
+		}
+		ret = kIOReturnSuccess;
+		break;
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapIncrementUse(void *id, __unused void *category, void *, void *, void *, void *)
+{
+	return useCount((uint32_t)(uintptr_t)id, true);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapDecrementUse(void *id, __unused void *category, void *, void *, void *, void *)
+{
+	return useCount((uint32_t)(uintptr_t)id, false);
 }
 
