 /* Per-client mapping of one surface. */
+/*
+ * The use count, what IOSurfaceIsInUse answers: the u64 at +0x18 of the shared state page (iOS 16.7 IOSurface:
+ * client->state page ->[0x18] != 0), kept by the kernel from traps 0 and 1 across every process; SweetFramebuffer adds
+ * its own holds to the same word. CVPixelBufferPool reuses a surface it finds not in use, so with the traps ignored
+ * VideoToolbox's HEVC tiles were recycled while being read: every HEIC grid image came out with tiles repeated, black
+ * or torn, differently each run (the Collections wallpapers).
+ */
+#define SWEET_SURFACE_STATE_USE         0x18
+
+static void
+sweet_surface_use(SweetSurface *s, SInt64 delta)
+{
+	OSAddAtomic64(delta, (volatile SInt64 *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USE));
+}
