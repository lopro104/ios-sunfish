diff --git a/iokit/Kernel/arm/SweetWiFi.cpp b/iokit/Kernel/arm/SweetWiFi.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetWiFi.cpp
@@ -0,0 +1,64 @@
+/*
+ * IO80211Interface stand-in for the Wi-Fi interface ew0 (bsd/dev/sweet_mpss.c).
+ *
+ * Apple's IO80211 library (Apple80211GetIfListCopy / Apple80211BindToInterface, used by wifid, MobileWiFi,
+ * and through them Settings) finds an interface by getifaddrs + SIOCGIFMEDIA (media type IEEE 802.11) and then
+ * looks up its IORegistry entry with IOServiceGetMatchingService({IOPropertyMatch: {IOInterfaceName: "ew0"}}),
+ * reading "IO80211InterfaceRole" ("Infrastructure"). With no IO80211Controller in the registry it falls back to
+ * plain SIOCGA80211/SIOCSA80211 ioctls on the interface, which sweet_mpss.c answers. So this service only has to
+ * exist, carry those properties, and be registered.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <device/device_types.h> /* io_buf_ptr_t for private OSKext headers */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+
+class IO80211Interface : public IOService {
+	OSDeclareDefaultStructors(IO80211Interface);
+};
+
+OSDefineMetaClassAndStructors(IO80211Interface, IOService);
+
+extern "C" void
+sweet_io80211_publish(const char *ifname, const uint8_t mac[6])
+{
+	IO80211Interface *iface = OSTypeAlloc(IO80211Interface);
+	OSNumber *n;
+	OSData *d;
+
+	if (iface == NULL || !iface->init()) {
+		OSSafeReleaseNULL(iface);
+		return;
+	}
+	iface->setName("ew0");
+	iface->setProperty("IOInterfaceName", ifname);
+	iface->setProperty("BSD Name", ifname);
+	iface->setProperty("IO80211InterfaceRole", "Infrastructure");
+	iface->setProperty("IOInterfaceNamePrefix", "ew");
+	n = OSNumber::withNumber(0ULL, 32);
+	iface->setProperty("IOInterfaceUnit", n);
+	OSSafeReleaseNULL(n);
+	n = OSNumber::withNumber(6ULL, 32);                     /* IFT_ETHER */
+	iface->setProperty("IOInterfaceType", n);
+	OSSafeReleaseNULL(n);
+	d = OSData::withBytes(mac, 6);
+	iface->setProperty("IOMACAddress", d);
+	OSSafeReleaseNULL(d);
+	iface->setProperty("IOPrimaryInterface", kOSBooleanTrue);
+	if (iface->attach(IOService::getPlatform())) {
+		iface->registerService();
+		IOLog("SWEET WIFI: IO80211Interface published for %s, registry ID %#llx\n", ifname, iface->getRegistryEntryID());
+	}
+	OSSafeReleaseNULL(iface);
+}
+#else
+extern "C" void sweet_io80211_publish(const char *, const unsigned char *);
+extern "C" void
+sweet_io80211_publish(const char *, const unsigned char *)
+{
+}
+#endif
