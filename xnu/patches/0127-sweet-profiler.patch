+/* the executable mappings of files below the shared region: our dylibs (Mesa, the GL layer) and the program */
+static void
+sweet_sample_images(const char *name, task_t task)
+{
+	struct proc_regioninfo_internal ri;
+	uint64_t address = 0;
+	uintptr_t vnode;
+	uint32_t vid;
+
+	for (int n = 0; n < 400; n++) {
+		bzero(&ri, sizeof(ri));
+		vnode = 0;
+		if (fill_procregioninfo_onlymappedvnodes(task, address, &ri, &vnode, &vid) == 0 ||
+		    ri.pri_address >= 0x180000000ULL || ri.pri_size == 0) {
+			break;
+		}
+		if ((ri.pri_protection & VM_PROT_EXECUTE) && vnode != 0 && vnode_getwithvid((vnode_t)vnode, vid) == 0) {
+			char path[MAXPATHLEN];
+			int length = sizeof(path);
+
+			if (vn_getpath((vnode_t)vnode, path, &length) != 0) {
+				strlcpy(path, "?", sizeof(path));
+			}
+			vnode_put((vnode_t)vnode);
+			printf("PRF img %s 0x%llx 0x%llx 0x%llx %s\n", name, ri.pri_address, ri.pri_size, ri.pri_offset, path);
+		}
+		address = ri.pri_address + ri.pri_size;
+	}
+}
 
