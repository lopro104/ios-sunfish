# HakiOS fragment: the Qualcomm SM7150 family (Snapdragon 730G/732G)
# 8 cores (6x Cortex-A55, 2x Cortex-A76), big core 7, Adreno 618 GPU.
CONFIG_SOC="sm7150"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
CONFIG_SOCINFO=y
CONFIG_THERMAL=y
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
