# HakiOS fragment: the Google Pixel 4a (sunfish) -- what is true of this device.
CONFIG_DEVICE="sunfish"
CONFIG_CPUS=8
CONFIG_FB_HZ=60
CONFIG_CA_VBL=1

# Storage
CONFIG_HAKIOS_UFS=y
CONFIG_UFS=2

# SoC & Core Services
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_PMIC=y
CONFIG_HAKIOS_BUTTONS=y

# Display: the command-mode panel (devices/sunfish/drivers/gpu). Compiled, not yet run through this tree
CONFIG_HAKIOS_CMDPANEL=y

# Touch: ST FTM5 (devices/sunfish/drivers/input). Compiled, not yet run through this tree
CONFIG_HAKIOS_FTM5=y
CONFIG_TOUCHSCREEN=y

# Off until ported: their addresses are the POCO X5 Pro's. cpufreq=1 would write to 0x18591000 (this SoC's OSM is at
# 0x18323000), and thermal=1 would read sensors at 0xc263000 (here 0xc222000, 0xc223000) under another chip's names.
# CONFIG_CPUFREQ is not set
# CONFIG_THERMAL is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set

# Phone drivers to bring up incrementally
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
CONFIG_FIRMWARE="none"
