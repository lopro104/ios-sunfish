                 uint32_t right = 0, covered = 0, leftCanary = 0, left = 0, gapCanary = 0, gap = 0;
                 const uint64_t slice = t->sliceBytes(), row = t->bytesPerRow();
                 for (uint32_t z = 0; z < D; z++) {
