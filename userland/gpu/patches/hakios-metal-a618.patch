---
 Makefile                | 18 +++++++++++-------
 src/iokit_transport.cpp |  4 ++++
 tools/probe.cpp         | 12 ++++++++++--
 3 files changed, 25 insertions(+), 9 deletions(-)

diff --git a/Makefile b/Makefile
index f559203..3f00fd3 100644
--- a/Makefile
+++ b/Makefile
@@ -25,6 +25,7 @@ ifeq ($(CHIP),618)
 override CXXFLAGS += -DHAKIOS_METAL_A618
 endif
 HOSTOUT   = out/host$(if $(CHIP),-a$(CHIP))$(if $(SAN),-$(SAN))
+IOSOUT    = out/ios$(if $(CHIP),-a$(CHIP))
 .DEFAULT_GOAL := test
 
 # The host tools that make shader kernels into fixtures (tools/kernels.mk), and the link of Mesa's compiler libraries
@@ -89,28 +90,31 @@ check: test
 	plugin/tests/metal-plugin-test.sh
 	GPU=1 plugin/tests/metal-plugin-test.sh
 
-ios: out/ios/hakios-metal-probe out/ios/libhakios-metal.a
+ios: $(IOSOUT)/hakios-metal-probe $(IOSOUT)/libhakios-metal.a
 
 darwin: ios
 
 # with MESA=1 the compiler goes to the phone too, against the iOS build of Mesa's libraries (IOS_MESA_BUILD, tools/compiler.mk)
 IOS_CXXFLAGS = -std=c++17 -O2 -Wall -Wextra -Werror
 IOS_LIBS     =
+ifeq ($(CHIP),618)
+IOS_CXXFLAGS += -DHAKIOS_METAL_A618
+endif
 ifneq ($(strip $(MESA)),)
 IOS_CXXFLAGS += -DHAKIOS_METAL_MESA $(HAKIOS_METAL_IOS_MESA_CXXFLAGS)
 IOS_LIBS     += $(HAKIOS_METAL_IOS_MESA_LIBS)
 endif
 
-out/ios/libhakios-metal.a: $(CORE) src/fake_gpu.cpp src/iokit_transport.cpp $(wildcard include/hakios-metal/*.hpp)
-	@mkdir -p out/ios/obj
-	cd out/ios/obj && for f in $(CORE) src/fake_gpu.cpp src/iokit_transport.cpp; do \
+$(IOSOUT)/libhakios-metal.a: $(CORE) src/fake_gpu.cpp src/iokit_transport.cpp $(wildcard include/hakios-metal/*.hpp)
+	@mkdir -p $(IOSOUT)/obj
+	cd $(IOSOUT)/obj && for f in $(CORE) src/fake_gpu.cpp src/iokit_transport.cpp; do \
 		$(IOS_CXX) $(IOS_CXXFLAGS) -I../../../include -c ../../../$$f || exit 1; done
-	rm -f $@ && $(IOS_AR) $@ out/ios/obj/*.o
+	rm -f $@ && $(IOS_AR) $@ $(IOSOUT)/obj/*.o
 
 # (and the front end's archive, as the host tests: a probe linked before the front end changed tests the old one)
-out/ios/hakios-metal-probe: tools/probe.cpp out/ios/libhakios-metal.a $(wildcard tests/fixtures/*.hpp) \
+$(IOSOUT)/hakios-metal-probe: tools/probe.cpp $(IOSOUT)/libhakios-metal.a $(wildcard tests/fixtures/*.hpp) \
 		$(if $(strip $(MESA)),$(IOS_MESA_BUILD)/src/compiler/air/libair.a)
-	$(IOS_CXX) $(IOS_CXXFLAGS) -Iinclude -o $@ tools/probe.cpp out/ios/libhakios-metal.a $(IOS_LIBS) \
+	$(IOS_CXX) $(IOS_CXXFLAGS) -Iinclude -o $@ tools/probe.cpp $(IOSOUT)/libhakios-metal.a $(IOS_LIBS) \
 		-framework IOKit -framework CoreFoundation -framework IOSurface
 
 
diff --git a/src/iokit_transport.cpp b/src/iokit_transport.cpp
index 48ef40e..8a5b86f 100644
--- a/src/iokit_transport.cpp
+++ b/src/iokit_transport.cpp
@@ -66,6 +66,10 @@ private:
 
 std::unique_ptr<Transport> openKernelGpu(std::string* why) {
     io_service_t s = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("HakiosGPU"));
+    if (s == 0) {
+        // ios-sunfish's kernel: SweetGPU, a port of this same driver (the same requests and structures)
+        s = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("SweetGPU"));
+    }
     if (s == 0) {
         *why = "no HakiosGPU service: the kernel has not started the GPU (gpu=1, the firmware in fw-gpu/, the phone)";
         return nullptr;
diff --git a/tools/probe.cpp b/tools/probe.cpp
index 89cc762..05d2037 100644
--- a/tools/probe.cpp
+++ b/tools/probe.cpp
@@ -374,13 +374,16 @@ static const char* dimName(uint8_t dim) {
 }
 
 int main(int argc, char** argv) {
-    bool recover = false, bisect = false, binTrace = false;
+    bool recover = false, bisect = false, binTrace = false, blitsOnly = false;
     compute::Options chosen;   // what the dispatches of stage 5 are encoded with
     std::vector<std::pair<std::string, std::string>> metallibs;   // --metallib FILE FUNCTION: a kernel of the phone's own image
     for (int i = 1; i < argc; i++) {
         recover = recover || strcmp(argv[i], "--recover") == 0;
         bisect = bisect || strcmp(argv[i], "--bisect") == 0;
         binTrace = binTrace || strcmp(argv[i], "--bin-trace") == 0;
+        // --blits-only: stages 1-4 (the command processor's copies and fills, no shader), for a GPU this driver has
