     {
@@ -1464,7 +1472,7 @@ int main(int argc, char** argv) {
                 const uint64_t words = t->buffer()->length() / 4;
                 for (uint64_t i = 0; i < words; i++) w[i] = canary;
                 const uint32_t groups[3] = {W / 8, H / 2, D - 1}, local82[3] = {8, 2, 1};
