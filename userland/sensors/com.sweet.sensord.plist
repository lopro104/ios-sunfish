<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sweet.sensord</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/sweet-sensor-ctl</string>
		<string>daemon</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/private/var/tmp/sweet-sensord.log</string>
	<key>StandardErrorPath</key>
	<string>/private/var/tmp/sweet-sensord.log</string>
</dict>
</plist>
